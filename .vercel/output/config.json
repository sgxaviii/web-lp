{
	"version": 3,
	"routes": [
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/404/?$",
			"dest": "_render"
		},
		{
			"src": "^/activitats/3x3/?$",
			"dest": "_render"
		},
		{
			"src": "^/activitats/casal/?$",
			"dest": "_render"
		},
		{
			"src": "^/activitats/sopar/?$",
			"dest": "_render"
		},
		{
			"src": "^/activitats/?$",
			"dest": "_render"
		},
		{
			"src": "^/club/equipaments/?$",
			"dest": "_render"
		},
		{
			"src": "^/club/historia/?$",
			"dest": "_render"
		},
		{
			"src": "^/club/quisom/?$",
			"dest": "_render"
		},
		{
			"src": "^/club/?$",
			"dest": "_render"
		},
		{
			"src": "^/contact/?$",
			"dest": "_render"
		},
		{
			"src": "^/equips/?$",
			"dest": "_render"
		},
		{
			"src": "^/legal/avis-legal/?$",
			"dest": "_render"
		},
		{
			"src": "^/legal/cookies/?$",
			"dest": "_render"
		},
		{
			"src": "^/legal/privacitat/?$",
			"dest": "_render"
		},
		{
			"src": "^/multimedia/?$",
			"dest": "_render"
		},
		{
			"src": "^/patrocinadors/?$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		},
		{
			"src": "^/.*$",
			"dest": "_render",
			"status": 404
		}
	]
}