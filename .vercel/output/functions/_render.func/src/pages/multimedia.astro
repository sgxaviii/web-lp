---
// src/pages/multimedia.astro
import Layout from "../layouts/Layout.astro";
import Container from "../components/container.astro"; // 🔴 Afegit per mantenir la consistència de marges
import { Icon } from "astro-icon/components";
import { createClient } from "@sanity/client";

// 1. Connexió amb el teu Sanity (en JS pur)
const client = createClient({
  projectId: "mytf86dr",        // El teu Project ID de Sanity
  dataset: "production",         // El teu dataset
  useCdn: true,                  // true per a respostes súper ràpides
  apiVersion: "2026-03-15",      // Versió de l'API de Sanity
});

// 2. Consulta GROQ per extreure les dades de Sanity
const query = `*[_type == "album"] | order(_createdAt desc) {
  _id,
  titol,
  descripcio,
  data_esdeveniment,
  categoria,
  tipus,
  enllac_amazon,
  "imatge_portada": imatge_portada.asset->url,
  color_tema
}`;

// Executem la consulta (sense tipats genèrics de TS)
const albums = await client.fetch(query);

// 3. Diccionari de colors (classes pures de Tailwind optimitzades per al fons fosc de gamma alta)
const colorMap = {
  blau: {
    border: "hover:border-azulElectrico/40",
    shadow: "hover:shadow-2xl hover:shadow-azulElectrico/25",
    gradient: "from-azulElectrico/20",
    text: "text-azulElectrico",
    bgHover: "group-hover:bg-azulElectrico",
    borderHover: "group-hover:border-azulElectrico",
    badge: "bg-azulElectrico/10 text-azulElectrico border-azulElectrico/20"
  },
  groc: {
    border: "hover:border-amarilloClub/45",
    shadow: "hover:shadow-2xl hover:shadow-amarilloClub/20",
    gradient: "from-amarilloClub/18",
    text: "text-amarilloClub",
    bgHover: "group-hover:bg-amarilloClub",
    borderHover: "group-hover:border-amarilloClub",
    badge: "bg-amarilloClub/10 text-amarilloClub border-amarilloClub/20"
  },
  turquesa: {
    border: "hover:border-teal-500/45",
    shadow: "hover:shadow-2xl hover:shadow-teal-500/15",
    gradient: "from-teal-500/15",
    text: "text-teal-500",
    bgHover: "group-hover:bg-teal-500",
    borderHover: "group-hover:border-teal-500",
    badge: "bg-teal-500/10 text-teal-400 border-teal-500/20"
  }
};
---

<Layout title="Multimèdia - AEB La Palma">
  <Container>
    <div class="mt-14 relative z-10">
      
      {/* 🔴 CORREGIT: Llums de fons ambientals que floten directament sobre el canvas de la pàgina */}
      <div class="absolute top-10 left-1/4 w-[500px] h-[500px] bg-azulElectrico/5 rounded-full blur-[120px] pointer-events-none -z-10"></div>
      <div class="absolute top-1/2 right-10 w-[400px] h-[400px] bg-amarilloClub/5 rounded-full blur-[120px] pointer-events-none -z-10"></div>

      {/* =========================================
          HERO DE LA PÀGINA
      ========================================= */}
      <section class="text-center max-w-3xl mx-auto pt-8 pb-12 relative z-10">
        <span class="inline-block bg-slate-950/90 border border-slate-800 text-amarilloClub uppercase tracking-wider text-xs font-black px-4 py-1.5 rounded-full shadow-inner mb-4">
          Galeria Oficial
        </span>
        <h1 class="text-5xl lg:text-6xl font-black text-white mt-4 uppercase tracking-tight leading-none">
          ELS NOSTRES <br/>
          <span class="text-azulElectrico">MOMENTS EN IMATGES</span>
        </h1>
        {/* 🔴 CORREGIT: Text passat de text-slate-400 a text-slate-300 per un contrast òptim */}
        <p class="text-lg mt-6 text-slate-300 max-w-xl mx-auto leading-relaxed">
          Accedeix a totes les nostres carpetes compartides d'Amazon Photos. Memòria gràfica dels partits, presentacions, tornejos i activitats del club.
        </p>
      </section>

      {/* 🔴 CORREGIT: Separador fi i elegant adaptat al fons fosc */}
      <hr class="border-slate-800/80 my-4" />

      {/* =========================================
          SECCIÓ: GRIDS DE L'ÀLBUM (TARGETES PREMIUM)
      ========================================= */}
      <section class="py-8 relative z-10">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
          
          {albums && albums.map((album) => {
            const styles = colorMap[album.color_tema] || colorMap.blau;
            const fallbackImage = "https://images.unsplash.com/photo-1546519638-68e109498ffc?q=80&w=600&auto=format&fit=crop";

            return (
              /* 🔴 CORREGIT: Targetes passades a fons bg-slate-950/60 amb vores fosques premium per unificar la línia de disseny */
              <a 
                href={album.enllac_amazon}
                target="_blank"
                rel="noopener noreferrer"
                class={`group relative flex flex-col justify-between bg-slate-950/60 backdrop-blur-md border border-slate-800/80 rounded-[2rem] overflow-hidden transition-all duration-500 min-h-[420px] ${styles.border} ${styles.shadow}`}
              >
                <div class={`absolute inset-0 bg-gradient-to-br ${styles.gradient} via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500`}></div>
                
                <div>
                  {/* Imatge de portada del bento card */}
                  <div class="relative h-48 w-full overflow-hidden border-b border-slate-800/80">
                    <img 
                      src={album.imatge_portada || fallbackImage} 
                      alt={album.titol}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                      loading="lazy"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-slate-950/90 via-transparent to-transparent"></div>
                    
                    {album.categoria && (
                      <span class="absolute top-4 left-4 text-xs font-black uppercase tracking-wider bg-slate-950/90 border border-slate-850 text-white px-3 py-1 rounded-full backdrop-blur-sm">
                        {album.categoria}
                      </span>
                    )}

                    <div class={`absolute top-4 right-4 w-9 h-9 rounded-xl border flex items-center justify-center backdrop-blur-sm ${styles.badge}`}>
                      {album.tipus === 'fotos' && <Icon class="w-5 h-5" name="uil:camera" />}
                      {album.tipus === 'videos' && <Icon class="w-5 h-5" name="uil:video" />}
                      {album.tipus === 'mix' && <Icon class="w-5 h-5" name="uil:scenery" />}
                    </div>
                  </div>

                  {/* Informació de l'àlbum */}
                  <div class="p-6 relative z-10">
                    {album.data_esdeveniment && (
                      <span class="text-xs font-bold text-slate-400 uppercase tracking-widest block">
                        {album.data_esdeveniment}
                      </span>
                    )}
                    <h2 class="text-xl font-black text-white uppercase tracking-tight mt-2 line-clamp-1">
                      {album.titol}
                    </h2>
                    {album.descripcio && (
                      <p class="text-slate-350 mt-3 leading-relaxed text-sm line-clamp-3">
                        {album.descripcio}
                      </p>
                    )}
                  </div>
                </div>

                {/* Footer de la targeta */}
                <div class="px-6 pb-6 pt-2 flex items-center justify-between relative z-10">
                  <div class="flex items-center gap-2 text-white font-bold text-sm tracking-wider uppercase group-hover:text-white transition-colors duration-300">
                    <span>Veure àlbum</span>
                    <Icon class="w-4 h-4 transform group-hover:translate-x-1.5 transition-transform duration-300" name="uil:external-link-alt" />
                  </div>
                  
                  <div class={`w-10 h-10 bg-slate-950 border border-slate-800/80 rounded-xl flex items-center justify-center shadow-inner ${styles.text} ${styles.bgHover} ${styles.borderHover} group-hover:text-white transition-all duration-300`}>
                    <Icon class="w-5 h-5" name="uil:image-v" />
                  </div>
                </div>
              </a>
            );
          })}

        </div>
      </section>

    </div>
  </Container>
</Layout>