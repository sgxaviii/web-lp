---
import Button from "./ui/button.astro";
---

<form
  action="https://api.web3forms.com/submit"
  method="POST"
  id="form"
  class="needs-validation"
  novalidate>
  <input type="hidden" name="access_key" value="3f81fd19-0787-4354-b21f-10bf9dcb7648" />
  <input type="checkbox" class="hidden" style="display:none" name="botcheck" />
  
  {/* Input: Nom complet */}
  <div class="mb-5">
    <input
      type="text"
      placeholder="Nom complet"
      required
      class="w-full px-4 py-3 border-2 placeholder:text-gray-500 rounded-md outline-hidden focus:ring-4 border-gray-300 focus:border-azulElectrico ring-azulElectrico/20 transition duration-200"
      name="name"
    />
    <div class="empty-feedback invalid-feedback text-red-650 text-sm mt-1 font-medium">
      Si us plau, introdueix el teu nom complet.
    </div>
  </div>

  {/* Input: Correu electrònic */}
  <div class="mb-5">
    <label for="email_address" class="sr-only">Correu electrònic</label>
    <input
      id="email_address"
      type="email"
      placeholder="Correu electrònic"
      name="email"
      required
      class="w-full px-4 py-3 border-2 placeholder:text-gray-500 rounded-md outline-hidden focus:ring-4 border-gray-300 focus:border-azulElectrico ring-azulElectrico/20 transition duration-200"
    />
    <div class="empty-feedback text-red-650 text-sm mt-1 font-medium">
      Si us plau, introdueix la teva adreça de correu electrònic.
    </div>
    <div class="invalid-feedback text-red-650 text-sm mt-1 font-medium">
      Si us plau, introdueix una adreça vàlida.
    </div>
  </div>

  {/* 📞 Input: Número de telèfon (Nou camp) */}
  <div class="mb-5">
    <label for="phone_number" class="sr-only">Número de telèfon</label>
    <input
      id="phone_number"
      type="tel"
      placeholder="Telèfon (Ex: +34 600 000 000)"
      name="phone"
      required
      pattern="^(?:\+34|0034|34)?[6789]\d{8}$"
      class="w-full px-4 py-3 border-2 placeholder:text-gray-500 rounded-md outline-hidden focus:ring-4 border-gray-300 focus:border-azulElectrico ring-azulElectrico/20 transition duration-200"
    />
    <div class="empty-feedback text-red-650 text-sm mt-1 font-medium">
      Si us plau, introdueix el teu número de telèfon.
    </div>
    <div class="invalid-feedback text-red-650 text-sm mt-1 font-medium">
      Introdueix un telèfon espanyol vàlid de 9 dígits (amb o sense prefix +34).
    </div>
  </div>

  {/* Textarea: Missatge */}
  <div class="mb-3">
    <textarea
      name="message"
      required
      placeholder="El teu missatge"
      class="w-full px-4 py-3 border-2 placeholder:text-gray-500 rounded-md outline-hidden h-36 focus:ring-4 border-gray-300 focus:border-azulElectrico ring-azulElectrico/20 transition duration-200"
    ></textarea>
    <div class="empty-feedback invalid-feedback text-red-650 text-sm mt-1 font-medium">
      Si us plau, introdueix el teu missatge.
    </div>
  </div>

  {/* Botó d'enviament */}
  <div class="relative group">
    <Button 
      type="submit" 
      size="lg" 
      block 
      class="bg-azulElectrico hover:bg-azulOscuro text-white font-bold py-3 px-6 rounded-md shadow-md transition duration-200"
    >
      Envia
    </Button>
  </div>

  {/* Text de resultat d'enviament */}
  <div id="result" class="mt-4 text-center font-bold text-sm"></div>
</form>

<style>
  .invalid-feedback,
  .empty-feedback {
    display: none;
  }

  .was-validated :placeholder-shown:invalid ~ .empty-feedback {
    display: block;
  }

  /* Modificat per evitar que la vora d'error es mostri mentre s'escriu un telèfon correcte */
  .was-validated :not(:placeholder-shown):invalid ~ .invalid-feedback {
    display: block;
  }

  /* Vora vermella d'error de validació utilitzant el vermell personalitzat del club */
  .is-invalid,
  .was-validated :invalid {
    border-color: var(--color-red-650, #E02424);
  }
</style>

<script is:inline>
  const form = document.getElementById("form");
  const result = document.getElementById("result");

  form.addEventListener("submit", function (e) {
    e.preventDefault();
    form.classList.add("was-validated");
    if (!form.checkValidity()) {
      form.querySelectorAll(":invalid")[0].focus();
      return;
    }
    
    // Eliminem espais del telèfon abans d'enviar per si l'usuari n'ha posat (Ex: +34 600 00 00 00 -> +34600000000)
    const phoneInput = form.querySelector("#phone_number");
    if (phoneInput) {
      phoneInput.value = phoneInput.value.replace(/\s+/g, '');
    }

    const formData = new FormData(form);
    const object = Object.fromEntries(formData);
    const json = JSON.stringify(object);

    result.style.display = "block";
    result.className = "mt-4 text-center font-bold text-sm text-amarilloClub";
    result.innerHTML = "Enviant missatge...";

    fetch("https://api.web3forms.com/submit", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        Accept: "application/json",
      },
      body: json,
    })
      .then(async (response) => {
        let json = await response.json();
        if (response.status == 200) {
          result.className = "mt-4 text-center font-bold text-sm text-green-500";
          result.innerHTML = "Missatge enviat correctament!";
        } else {
          console.log(response);
          result.className = "mt-4 text-center font-bold text-sm text-red-650";
          result.innerHTML = json.message || "Hi ha hagut un error.";
        }
      })
      .catch((error) => {
        console.log(error);
        result.className = "mt-4 text-center font-bold text-sm text-red-650";
        result.innerHTML = "Alguna cosa ha anat malament!";
      })
      .then(function () {
        form.reset();
        form.classList.remove("was-validated");
        setTimeout(() => {
          result.style.display = "none";
        }, 5000);
      });
  });
</script>