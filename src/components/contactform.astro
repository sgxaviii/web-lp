---
import Button from "./ui/button.astro";
---

<form
  action="https://api.web3forms.com/submit"
  method="POST"
  id="form"
  class="needs-validation"
  novalidate>
  <input type="hidden" name="access_key" value="3f81fd19-0787-4354-b21f-10bf9dcb7648" />
  <input type="checkbox" class="hidden" style="display:none" name="botcheck" />
  
  {/* Input: Nom complet */}
  <div class="mb-5">
    <input
      type="text"
      placeholder="Nom complet"
      required
      class="w-full px-4 py-3 bg-slate-950/40 text-white border-2 placeholder:text-slate-500 rounded-xl outline-hidden focus:ring-4 border-slate-800 focus:border-azulElectrico focus:bg-slate-950/80 ring-azulElectrico/25 transition duration-200"
      name="name"
    />
    <div class="empty-feedback invalid-feedback text-red-500 text-sm mt-1 font-medium">
      Si us plau, introdueix el teu nom complet.
    </div>
  </div>

  {/* Input: Correu electrònic */}
  <div class="mb-5">
    <label for="email_address" class="sr-only">Correu electrònic</label>
    <input
      id="email_address"
      type="email"
      placeholder="Correu electrònic"
      name="email"
      required
      class="w-full px-4 py-3 bg-slate-950/40 text-white border-2 placeholder:text-slate-500 rounded-xl outline-hidden focus:ring-4 border-slate-800 focus:border-azulElectrico focus:bg-slate-950/80 ring-azulElectrico/25 transition duration-200"
    />
    <div class="empty-feedback text-red-500 text-sm mt-1 font-medium">
      Si us plau, introdueix la teva adreça de correu electrònic.
    </div>
    <div class="invalid-feedback text-red-500 text-sm mt-1 font-medium">
      Si us plau, introdueix una adreça vàlida.
    </div>
  </div>

  {/* 📞 Input: Número de telèfon */}
  <div class="mb-5">
    <label for="phone_number" class="sr-only">Número de telèfon</label>
    <input
      id="phone_number"
      type="tel"
      placeholder="Telèfon (Ex: +34 600 000 000)"
      name="phone"
      required
      pattern="^(?:\+34|0034|34)?[6789]\d{8}$"
      class="w-full px-4 py-3 bg-slate-950/40 text-white border-2 placeholder:text-slate-500 rounded-xl outline-hidden focus:ring-4 border-slate-800 focus:border-azulElectrico focus:bg-slate-950/80 ring-azulElectrico/25 transition duration-200"
    />
    <div class="empty-feedback text-red-500 text-sm mt-1 font-medium">
      Si us plau, introdueix el teu número de telèfon.
    </div>
    <div class="invalid-feedback text-red-500 text-sm mt-1 font-medium">
      Introdueix un telèfon espanyol vàlid de 9 dígits (amb o sense prefix +34).
    </div>
  </div>

  {/* Textarea: Missatge */}
  <div class="mb-4">
    <textarea
      name="message"
      required
      placeholder="El teu missatge..."
      class="w-full px-4 py-3 bg-slate-950/40 text-white border-2 placeholder:text-slate-500 rounded-xl outline-hidden h-36 focus:ring-4 border-slate-800 focus:border-azulElectrico focus:bg-slate-950/80 ring-azulElectrico/25 transition duration-200 resize-none"
    ></textarea>
    <div class="empty-feedback invalid-feedback text-red-500 text-sm mt-1 font-medium">
      Si us plau, introdueix el teu missatge.
    </div>
  </div>

  {/* Botó d'enviament */}
  <div class="relative group">
    <Button 
      type="submit" 
      size="lg" 
      block 
      class="bg-azulElectrico hover:bg-azulOscuro text-white font-black uppercase tracking-wider py-3.5 px-6 rounded-xl shadow-md shadow-azulElectrico/10 hover:shadow-azulOscuro/20 transition duration-200 cursor-pointer"
    >
      Envia el missatge
    </Button>
  </div>

  {/* Text de resultat d'enviament */}
  <div id="result" class="mt-4 text-center font-bold text-sm"></div>
</form>

<style>
  .invalid-feedback,
  .empty-feedback {
    display: none;
  }

  .was-validated :placeholder-shown:invalid ~ .empty-feedback {
    display: block;
  }

  .was-validated :not(:placeholder-shown):invalid ~ .invalid-feedback {
    display: block;
  }

  /* Vora vermella d'error integrada harmònicament sobre el fons fosc */
  .is-invalid,
  .was-validated :invalid {
    border-color: #EF4444 !important;
  }
</style>

<script is:inline>
  const form = document.getElementById("form");
  const result = document.getElementById("result");

  form.addEventListener("submit", function (e) {
    e.preventDefault();
    form.classList.add("was-validated");
    if (!form.checkValidity()) {
      form.querySelectorAll(":invalid")[0].focus();
      return;
    }
    
    const phoneInput = form.querySelector("#phone_number");
    if (phoneInput) {
      phoneInput.value = phoneInput.value.replace(/\s+/g, '');
    }

    const formData = new FormData(form);
    const object = Object.fromEntries(formData);
    const json = JSON.stringify(object);

    result.style.display = "block";
    result.className = "mt-4 text-center font-bold text-sm text-amarilloClub animate-pulse";
    result.innerHTML = "Enviant missatge...";

    fetch("https://api.web3forms.com/submit", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        Accept: "application/json",
      },
      body: json,
    })
      .then(async (response) => {
        let json = await response.json();
        if (response.status == 200) {
          result.className = "mt-4 text-center font-bold text-sm text-emerald-500";
          result.innerHTML = "Missatge enviat correctament!";
        } else {
          console.log(response);
          result.className = "mt-4 text-center font-bold text-sm text-red-500";
          result.innerHTML = json.message || "Hi ha hagut un error.";
        }
      })
      .catch((error) => {
        console.log(error);
        result.className = "mt-4 text-center font-bold text-sm text-red-500";
        result.innerHTML = "Alguna cosa ha anat malament!";
      })
      .then(function () {
        form.reset();
        form.classList.remove("was-validated");
        setTimeout(() => {
          result.style.display = "none";
        }, 5000);
      });
  });
</script>