---
import Link from "./ui/link.astro";
---

<div
  class="bg-gradient-to-br from-slate-950 via-slate-900 to-slate-950 border-2 border-amarilloClub p-8 md:px-20 md:py-16 mt-20 mx-auto max-w-5xl rounded-2xl flex flex-col items-center text-center shadow-2xl relative overflow-hidden group">
  
  <!-- Efecte decoratiu de fons per donar un toc elèctric (opcional) -->
  <div class="absolute top-0 right-0 w-48 h-48 bg-azulElectrico/10 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-0 left-0 w-48 h-48 bg-amarilloClub/5 rounded-full blur-3xl pointer-events-none"></div>

  <!-- Títol Principal -->
  <h2 class="text-white text-3xl md:text-5xl font-black tracking-tight uppercase max-w-3xl leading-tight">
    Vols vestir la nostra samarreta <span class="text-amarilloClub">la pròxima temporada?</span>
  </h2>
  
  <!-- Descripció -->
  <p class="text-slate-300 mt-5 text-base md:text-lg max-w-2xl font-medium leading-relaxed">
    Els nostres equips ja s'estan preparant i sempre busquem nous jugadors i jugadores amb ganes de gaudir d'aquest esport. Vine a provar un entrenament completament de franc i sense cap compromís!
  </p>
  
  <!-- Botons d'Acció -->
  <div class="flex flex-col sm:flex-row gap-4 mt-8 w-full justify-center items-center">
    
    {/* Botó Principal: Contacte */}
    <Link 
      href="/contact" 
      style="primary" 
      class="w-full sm:w-auto px-8 py-3 bg-azulElectrico hover:bg-indigo-700 text-white font-black uppercase tracking-wider rounded-xl shadow-lg transition duration-200 text-center text-sm"
    >
      📞 Contacta ara
    </Link>

    {/* Botó Secundari: Veure Equips */}
    <Link 
      href="/equips" 
      style="inverted" 
      class="w-full sm:w-auto px-8 py-3 bg-transparent hover:bg-slate-800 text-slate-300 hover:text-white font-bold rounded-xl border border-slate-700 transition duration-200 text-center text-sm"
    >
      🏀 Veure horaris
    </Link>
    
  </div>
</div>