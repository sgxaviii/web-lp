---
// src/components/Footer.astro
import Container from "@/components/container.astro";
import { Icon } from "astro-icon/components";

// Any actual per al Copyright dinàmic
const anyActual = new Date().getFullYear();

// Enllaços de contacte i xarxes (Modifica'ls amb les teves dades reals)
const instagramUrl = "https://www.instagram.com/aeblapalma/"; // Enllaç real d'Instagram
const whatsappUrl = "https://wa.me/34600000000"; // Enllaç de WhatsApp (canvia el telèfon)
const correuContacte = "info@aeblapalma.cat";
const facebookUrl = "https://www.facebook.com/aeblapalma"; // Enllaç real de Facebook
const tiktokUrl = "https://www.tiktok.com/@aeblapalma"; // Enllaç real de TikTok
const direccioPoliesportiu = "Carrer del Canigó, 9, 08756 La Palma de Cervelló";
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(direccioPoliesportiu)}`;

// 🌟 URL del teu perfil personal de GitHub
const githubUrl = "https://github.com/sgxaviii";
---

<footer class="bg-slate-900 text-slate-400 mt-24 pt-16 pb-8 border-t border-slate-800 rounded-t-[2.5rem] relative overflow-hidden">
  {/* Element decoratiu de fons en forma de marca d'aigua */}
  <div class="absolute -right-20 -bottom-20 pointer-events-none select-none">
    <img src="/logo.png" class="w-96 h-96 opacity-[0.04] object-contain" alt="" />
  </div>

  <Container>
    <div class="relative z-10 grid grid-cols-1 md:grid-cols-3 gap-10 md:gap-8 pb-12 border-b border-slate-800">
      
      {/* COLUMNA 1: Sobre el Club i Xarxes Socials */}
      <div class="space-y-4">
        
        {/* 🌟 MODIFICAT: S'ha convertit tot el contenidor en un enllaç a l'inici, unificant logo i títol */}
        <a 
          href="/" 
          class="inline-flex items-center gap-3 hover:opacity-90 transition-opacity duration-200 select-none"
          aria-label="AEB La Palma - Tornar a l'inici"
        >
          {/* El saquet groc del logo ara és un div intern */}
          <div class="bg-amarilloClub p-1.5 rounded-lg flex items-center justify-center shrink-0 w-12 h-12">
            <img 
              src="/logo.png" 
              alt="Logo AEB La Palma" 
              class="w-8 h-8 object-contain" 
              style="filter: brightness(0) saturate(100%) invert(22%) sepia(96%) saturate(2745%) hue-rotate(220deg) brightness(93%) contrast(94%);"
            />
          </div>

          {/* El títol ara és perfectament clicable també */}
          <span class="font-black text-white text-lg tracking-wider uppercase">AEB La Palma</span>
        </a>

        <p class="text-sm text-slate-400 leading-relaxed max-w-sm">
          Més que un club, una gran família dedicada a promoure el bàsquet, els valors de l'esport de lleure i la convivència a La Palma de Cervelló.
        </p>
        
        {/* Enllaços de Xarxes */}
        <div class="flex gap-3 pt-2">
          <a 
            href={instagramUrl} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="bg-slate-800 text-slate-300 p-2.5 rounded-xl hover:text-white hover:bg-pink-600 transition duration-200"
            aria-label="Segueix-nos a Instagram"
          >
            <Icon class="w-5 h-5" name="uil:instagram" />
          </a>
          <a 
            href={whatsappUrl} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="bg-slate-800 text-slate-300 p-2.5 rounded-xl hover:text-white hover:bg-emerald-600 transition duration-200"
            aria-label="Contacta per WhatsApp"
          >
            <Icon class="w-5 h-5" name="uil:whatsapp" />
          </a>
                    <a 
            href={facebookUrl} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="bg-slate-800 text-slate-300 p-2.5 rounded-xl hover:text-white hover:bg-blue-600 transition duration-200"
            aria-label="Segueix-nos a Facebook"
          >
            <Icon class="w-5 h-5" name="uil:facebook" />
          </a>
                    <a 
            href={tiktokUrl} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="bg-slate-800 text-slate-300 p-2.5 rounded-xl hover:text-white hover:bg-[#FE2C55] transition duration-200"
            aria-label="Segueix-nos a TikTok"
          >
            <Icon class="w-5 h-5" name="uil:video" />
          </a>
        </div>
      </div>

      {/* COLUMNA 2: Contacte i Horaris */}
      <div class="space-y-4">
        <h3 class="text-xs font-bold text-slate-200 uppercase tracking-widest">Contacte i Horaris</h3>
        <ul class="space-y-3 text-sm">
          <li>
            <a href={`mailto:${correuContacte}`} class="flex items-center gap-3 hover:text-white transition duration-200 group">
              <div class="bg-slate-800 p-2 rounded-lg group-hover:bg-slate-700 transition duration-200 shrink-0">
                <Icon class="w-4 h-4 text-amarilloClub" name="uil:envelope" />
              </div>
              <span class="truncate">{correuContacte}</span>
            </a>
          </li>
          <li>
            <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="flex items-start gap-3 hover:text-white transition duration-200 group">
              <div class="bg-slate-800 p-2 rounded-lg group-hover:bg-slate-700 transition duration-200 shrink-0 mt-0.5">
                <Icon class="w-4 h-4 text-amarilloClub" name="uil:map-marker" />
              </div>
              <span class="leading-relaxed text-xs">{direccioPoliesportiu}</span>
            </a>
          </li>
        </ul>
      </div>

      {/* COLUMNA 3: Enllaços d'Interès / Seccions */}
      <div class="space-y-4">
        <h3 class="text-xs font-bold text-slate-200 uppercase tracking-widest">Enllaços ràpids</h3>
        <ul class="grid grid-cols-2 gap-2 text-sm">
          <li><a href="/" class="hover:text-white transition duration-200">Inici</a></li>
          <li><a href="/activitats" class="hover:text-white transition duration-200">Activitats</a></li>
          <li><a href="/activitats/3x3" class="hover:text-white transition duration-200">Torneig 3x3</a></li>
          <li><a href="/contact" class="hover:text-white transition duration-200">Contactar</a></li>
        </ul>
      </div>

    </div>

    {/* BARRA INFERIOR (Copyright, Crèdits, Dades i Cookies) */}
    <div class="relative z-10 pt-8 flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-slate-400">
      
      <div class="flex flex-col sm:flex-row items-center gap-2 sm:gap-3 text-center sm:text-left">
        <p>Copyright © {anyActual} AEB La Palma. Tots els drets reservats.</p>
        <span class="hidden sm:inline text-slate-700">|</span>
        <a 
          href={githubUrl} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="inline-flex items-center gap-1.5 text-slate-500 hover:text-white transition duration-200 group"
        >
          <Icon class="w-4 h-4 text-slate-600 group-hover:text-white transition duration-200" name="uil:github" />
          <span>Fet per <span class="font-medium text-slate-400 group-hover:text-white">Xavi Momplet</span></span>
        </a>
      </div>

      {/* Enllaços Legals */}
      <div class="flex flex-wrap gap-x-6 gap-y-2 justify-center">
        <a href="/legal/privacitat" class="hover:text-slate-300 transition duration-200">
          Tractament de dades i Privacitat
        </a>
        <a href="/legal/cookies" class="hover:text-slate-300 transition duration-200">
          Política de Cookies
        </a>
        <a href="/legal/avis-legal" class="hover:text-slate-300 transition duration-200">
          Avís Legal
        </a>
      </div>
    </div>
  </Container>
</footer>