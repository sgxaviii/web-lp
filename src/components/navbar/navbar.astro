---
import Container from "@/components/container.astro";
import Link from "@/components/ui/link.astro";
import Dropdown from "./dropdown.astro";
import { Astronav, MenuItems, MenuIcon } from "astro-navbar";
import { Icon } from "astro-icon/components"; 

const menuitems = [
  {
    title: "Equips",
    path: "/equips",
    children: [
      { title: "Sènior A", path: "/equips/seniorA" },
      { title: "Sènior B", path: "/equips/seniorB" },
      { title: "Sots 25", path: "/equips/sots25" },
      { title: "Escola", path: "/equips/escola" },
    ],
  },
  {
    title: "Club",
    path: "/about",
  },
  {
    title: "Contacte",
    path: "/contact",
  },
  {
    title: "Casal",
    path: "/casal",
  },
];
---

<Container>
  <header class="flex flex-col lg:flex-row justify-between items-center my-5">
    <Astronav>
      <div class="flex w-full lg:w-auto items-center justify-between">
        <a href="/" class="flex items-center space-x-2 text-lg font-bold text-slate-800">
          <Icon class="w-6 h-6 text-indigo-600" name="uil:basketball" /> 
          <span>AEB La Palma</span>
        </a>
        
        <div class="block lg:hidden">
          <MenuIcon class="w-4 h-4 text-gray-800" />
        </div>
      </div>
      
      <MenuItems class="hidden w-full lg:w-auto mt-2 lg:flex lg:mt-0 items-center">
        <ul class="flex flex-col lg:flex-row lg:gap-3 w-full lg:w-auto">
          {
            menuitems.map((item, index) => (
              <>
                {item.children && (
                  <Dropdown
                    title={item.title}
                    path={item.path} {/* 🌟 CAMBIO AQUÍ: Passem el path a l'actual desplegable */}
                    children={item.children}
                    lastItem={index === menuitems.length - 1}
                  />
                )}

                {!item.children && (
                  <li>
                    <a
                      href={item.path}
                      class="flex lg:px-3 py-2 items-center text-gray-600 hover:text-gray-900">
                      <span> {item.title}</span>
                      {item.badge && (
                        <span class="ml-1 px-2 py-0.5 text-[10px] animate-pulse font-semibold uppercase text-white bg-indigo-600 rounded-full">
                          New
                        </span>
                      )}
                    </a>
                  </li>
                )}
              </>
            ))
          }
          
          {/* 📱 XARXES SOCIALS - VERSIÓ MÒBIL (Ocult en pantalles grans) */}
          <li class="lg:hidden border-t border-gray-100 mt-4 pt-4 grid grid-cols-2 gap-4">
            <a 
              href="https://instagram.com/aeblapalma" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="flex items-center text-gray-600 hover:text-pink-600 transition-colors"
            >
              <Icon class="w-5 h-5 mr-2" name="uil:instagram" />
              <span>Instagram</span>
            </a>

            <a 
              href="https://facebook.com/el-teu-club" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="flex items-center text-gray-600 hover:text-blue-600 transition-colors"
            >
              <Icon class="w-5 h-5 mr-2" name="uil:facebook" />
              <span>Facebook</span>
            </a>

            <a 
              href="https://tiktok.com/@el-teu-club" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="flex items-center text-gray-600 hover:text-black transition-colors"
            >
              <Icon class="w-5 h-5 mr-2" name="uil:video" />
              <span>TikTok</span>
            </a>

            <a 
              href="https://wa.me/34600000000" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="flex items-center text-gray-600 hover:text-green-500 transition-colors"
            >
              <Icon class="w-5 h-5 mr-2" name="uil:whatsapp" />
              <span>WhatsApp</span>
            </a>
          </li>
        </ul>
      </MenuItems>
    </Astronav>
    
    {/* 💻 XARXES SOCIALS - VERSIÓ ESCRIPTORI (Ocult en mòbils) */}
    <div class="hidden lg:flex items-center gap-1">
      <a 
        href="https://facebook.com/AEBLaPalma/" 
        target="_blank" 
        rel="noopener noreferrer" 
        title="Facebook"
        class="text-gray-600 hover:text-blue-600 transition-colors p-2"
      >
        <Icon class="w-6 h-6" name="uil:facebook" />
      </a>

      <a 
        href="https://instagram.com/aeblapalma" 
        target="_blank" 
        rel="noopener noreferrer" 
        title="Instagram"
        class="text-gray-600 hover:text-pink-600 transition-colors p-2"
      >
        <Icon class="w-6 h-6" name="uil:instagram" />
      </a>

      <a 
        href="https://tiktok.com/@aeblapalma" 
        target="_blank" 
        rel="noopener noreferrer" 
        title="TikTok"
        class="text-gray-600 hover:text-red-500 transition-colors p-2"
      >
        <Icon class="w-6 h-6" name="uil:video" />
      </a>

      <a 
        href="https://wa.me/34644279680" 
        target="_blank" 
        rel="noopener noreferrer" 
        title="WhatsApp"
        class="text-gray-600 hover:text-green-500 transition-colors p-2"
      >
        <Icon class="w-6 h-6" name="uil:whatsapp" />
      </a>
    </div>
  </header>
</Container>