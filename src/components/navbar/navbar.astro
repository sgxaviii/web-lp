---
import Container from "@/components/container.astro";
import Link from "@/components/ui/link.astro";
import Dropdown from "./dropdown.astro";
import { Astronav, MenuItems, MenuIcon } from "astro-navbar";
import { Icon } from "astro-icon/components";

// 🌟 Importem el client de Sanity per demanar les dades dels equips reals
import { sanityClient } from "sanity:client";

// Demanem els equips i els ordenem alfabèticament
const equipsBaseDeDades = await sanityClient.fetch(
  `*[_type == "equip"] | order(nom asc){ nom, "slug": slug.current }`
);

const esdevenimentsBaseDeDades = await sanityClient.fetch(
  `*[_type == "activitat"] | order(titol asc){ titol, "slug": slug.current }`
)

// Mapegem la informació de la base de dades a l'estructura del menú "children"
const equipsMapejats = equipsBaseDeDades.map((equip) => ({
  title: equip.nom,
  path: `/equips/${equip.slug}`,
}));

const esdevenimentsMapejats = esdevenimentsBaseDeDades.map((activitat) => ({
  title: activitat.titol,
  path: `/esdeveniments/${activitat.slug}`
}));

// Estructura dinàmica del menú
const menuitems = [
  {
    title: "Equips",
    path: "/equips",
    children: equipsMapejats,
  },
  {
    title: "Club",
    path: "/club",
    children: [
      { title: "Qui som", path: "/club/quisom" },
      { title: "Història", path: "/club/historia" },
      { title: "Equipaments", path: "/club/equipaments"}
    ],
  },
  {
    title: "Esdeveniments",
    path: "/esdeveniments",
    children: esdevenimentsMapejats,
  },
  {
    title: "Multimèdia",
    path: "/multimedia",
  },
  {
    title: "Contacte",
    path: "/contact",
  },
  {
    title: "Patrocinadors",
    path: "/patrocinadors"
  },
];
---

<Container>
  <header class="flex flex-col lg:flex-row justify-between items-stretch lg:items-center my-6 bg-slate-900/95 backdrop-blur-md border border-slate-800 px-6 py-4 rounded-3xl shadow-xl shadow-slate-950/20 relative z-50">
    <Astronav>
      {/* CONTENIDOR CORREGIT PER A MÒBILS */}
      <div class="flex w-full lg:w-auto items-center justify-between">
        
        {/* LOGO I TÍTOL */}
        <a href="/" class="flex items-center space-x-3 text-lg sm:text-xl font-black text-white uppercase tracking-tight hover:opacity-90 transition-opacity select-none">
          <img 
            src="/logo.png" 
            alt="Logo AEB La Palma" 
            class="w-10 h-10 object-contain rounded-md"
          /> 
          <span>AEB La Palma</span>
        </a>
        
        {/* ICONA MÒBIL */}
        <div class="block lg:hidden translate-y-[2px]">
          <MenuIcon class="w-10 h-10 text-white hover:text-amarilloClub bg-transparent hover:bg-slate-800/60 p-2 rounded-xl transition-all duration-200 cursor-pointer" />
        </div>

      </div>
      
      <MenuItems class="hidden w-full lg:w-auto mt-4 lg:flex lg:mt-0 items-center">
        <ul class="flex flex-col lg:flex-row lg:gap-3 w-full lg:w-auto">
          {
            menuitems.map((item, index) => (
              <>
                {item.children && item.children.length > 0 && (
                  <Dropdown
                    title={item.title}
                    path={item.path}
                    children={item.children}
                    badge={item.badge}
                    lastItem={index === menuitems.length - 1}
                  />
                )}

                {(!item.children || item.children.length === 0) && (
                  <li>
                    <a
                      href={item.path}
                      class="flex lg:px-3 py-2 items-center text-slate-300 hover:text-amarilloClub font-semibold transition-colors duration-200">
                      <span> {item.title}</span>
                      {item.badge && (
                        <span class="ml-1.5 px-2 py-0.5 text-[9px] font-black uppercase text-azulOscuro bg-amarilloClub rounded-md shadow-sm">
                          Estiu
                        </span>
                      )}
                    </a>
                  </li>
                )}
              </>
            ))
          }
          
          {/* 📱 XARXES SOCIALS - VERSIÓ MÒBIL */}
          <li class="lg:hidden border-t border-slate-800 mt-4 pt-4 grid grid-cols-2 gap-4">
            <a 
              href="https://instagram.com/aeblapalma" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="flex items-center text-slate-400 hover:text-pink-500 transition-colors"
            >
              <Icon class="w-5 h-5 mr-2" name="uil:instagram" />
              <span>Instagram</span>
            </a>

            <a 
              href="https://facebook.com/AEBLaPalma/" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="flex items-center text-slate-400 hover:text-blue-500 transition-colors"
            >
              <Icon class="w-5 h-5 mr-2" name="uil:facebook" />
              <span>Facebook</span>
            </a>

            <a 
              href="https://tiktok.com/@aeblapalma" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="flex items-center text-slate-400 hover:text-[#FE2C55] transition-colors"
            >
              <Icon class="w-5 h-5 mr-2" name="simple-icons:tiktok" />
              <span>TikTok</span>
            </a>

            <a 
              href="https://wa.me/34644279680" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="flex items-center text-slate-400 hover:text-green-500 transition-colors"
            >
              <Icon class="w-5 h-5 mr-2" name="uil:whatsapp" />
              <span>WhatsApp</span>
            </a>
          </li>
        </ul>
      </MenuItems>
    </Astronav>
    
    {/* 💻 XARXES SOCIALS - VERSIÓ ESCRIPTORI */}
    <div class="hidden lg:flex items-center gap-1">
      <a 
        href="https://facebook.com/AEBLaPalma/" 
        target="_blank" 
        rel="noopener noreferrer" 
        title="Facebook"
        class="text-slate-400 hover:text-blue-500 transition-colors p-2"
      >
        <Icon class="w-5 h-5" name="uil:facebook" />
      </a>

      <a 
        href="https://instagram.com/aeblapalma" 
        target="_blank" 
        rel="noopener noreferrer" 
        title="Instagram"
        class="text-slate-400 hover:text-pink-500 transition-colors p-2"
      >
        <Icon class="w-5 h-5" name="uil:instagram" />
      </a>

      {/* 🌟 CORREGIT: Canviat 'hover:text-white' per 'hover:text-[#FE2C55]' perquè es vegi vermell en ordinadors */}
      <a 
        href="https://tiktok.com/@aeblapalma" 
        target="_blank" 
        rel="noopener noreferrer" 
        title="TikTok"
        class="text-slate-400 hover:text-[#FE2C55] transition-colors p-2"
      >
        <Icon class="w-5 h-5" name="simple-icons:tiktok" />
      </a>

      <a 
        href="https://wa.me/34644279680" 
        target="_blank" 
        rel="noopener noreferrer" 
        title="WhatsApp"
        class="text-slate-400 hover:text-green-500 transition-colors p-2"
      >
        <Icon class="w-5 h-5" name="uil:whatsapp" />
      </a>
    </div>
  </header>
</Container>