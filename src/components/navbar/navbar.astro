---
import Container from "@/components/container.astro";
import Link from "@/components/ui/link.astro";
import Dropdown from "./dropdown.astro";
import { Astronav, MenuItems, MenuIcon } from "astro-navbar";
import { Icon } from "astro-icon/components";

// 🌟 Importem el client de Sanity per demanar les dades dels equips reals
import { sanityClient } from "sanity:client";

// Demanem els equips i els ordenem alfabèticament
const equipsBaseDeDades = await sanityClient.fetch(
  `*[_type == "equip"] | order(nom asc){ nom, "slug": slug.current }`
);

// Mapegem la informació de la base de dades a l'estructura del menú "children"
const equipsMapejats = equipsBaseDeDades.map((equip) => ({
  title: equip.nom,
  path: `/equips/${equip.slug}`,
}));

// Estructura dinàmica del menú
const menuitems = [
  {
    title: "Equips",
    path: "/equips",
    children: equipsMapejats,
  },
  {
    title: "Club",
    path: "/about",
  },
  {
    title: "Equipaments",
    path: "/equipaments"
  },
  {
    title: "Activitats Extra",
    path: "/activitats",
    badge: true,
    // 🌟 AFEGITS ELS FILLS AQUÍ:
    children: [
      { title: "Sopar de Temporada", path: "/activitats/sopar" },
      { title: "Torneig 3x3", path: "/activitats/3x3" },
      { title: "Casal d'Estiu", path: "/activitats/casal" }
    ]
  }, // 👈 Afegida la coma que faltava aquí per evitar errors de compilació
  {
    title: "Contacte",
    path: "/contact",
  },
];
---

<Container>
  <header class="flex flex-col lg:flex-row justify-between items-center my-5">
    <Astronav>
      <div class="flex w-full lg:w-auto items-center justify-between">
        <a href="/" class="flex items-center space-x-2 text-xl font-black text-slate-900 uppercase tracking-tight hover:opacity-90 transition-opacity">
          <Icon class="w-6 h-6 text-azulElectrico" name="uil:basketball" /> 
          <span>AEB La Palma</span>
        </a>
        
        <div class="block lg:hidden">
          <MenuIcon class="w-5 h-5 text-slate-800 hover:text-azulElectrico transition-colors" />
        </div>
      </div>
      
      <MenuItems class="hidden w-full lg:w-auto mt-2 lg:flex lg:mt-0 items-center">
        <ul class="flex flex-col lg:flex-row lg:gap-3 w-full lg:w-auto">
          {
            menuitems.map((item, index) => (
              <>
                {item.children && (
                  <Dropdown
                    title={item.title}
                    path={item.path}
                    children={item.children}
                    badge={item.badge}
                    lastItem={index === menuitems.length - 1}
                  />
                )}

                {!item.children && (
                  <li>
                    <a
                      href={item.path}
                      class="flex lg:px-3 py-2 items-center text-slate-600 hover:text-azulElectrico font-semibold transition-colors duration-200">
                      <span> {item.title}</span>
                      {item.badge && (
                        /* 🌟 RECUADRE ESTÀTIC (Sense 'animate-pulse') */
                        <span class="ml-1.5 px-2 py-0.5 text-[9px] font-black uppercase text-azulOscuro bg-amarilloClub rounded-md shadow-sm">
                          Estiu
                        </span>
                      )}
                    </a>
                  </li>
                )}
              </>
            ))
          }
          
          {/* 📱 XARXES SOCIALS - VERSIÓ MÒBIL (Ocult en pantalles grans) */}
          <li class="lg:hidden border-t border-slate-100 mt-4 pt-4 grid grid-cols-2 gap-4">
            <a 
              href="https://instagram.com/aeblapalma" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="flex items-center text-slate-600 hover:text-pink-600 transition-colors"
            >
              <Icon class="w-5 h-5 mr-2" name="uil:instagram" />
              <span>Instagram</span>
            </a>

            <a 
              href="https://facebook.com/AEBLaPalma/" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="flex items-center text-slate-600 hover:text-blue-600 transition-colors"
            >
              <Icon class="w-5 h-5 mr-2" name="uil:facebook" />
              <span>Facebook</span>
            </a>

            <a 
              href="https://tiktok.com/@aeblapalma" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="flex items-center text-slate-600 hover:text-slate-950 transition-colors"
            >
              <Icon class="w-5 h-5 mr-2" name="uil:video" />
              <span>TikTok</span>
            </a>

            <a 
              href="https://wa.me/34644279680" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="flex items-center text-slate-600 hover:text-green-500 transition-colors"
            >
              <Icon class="w-5 h-5 mr-2" name="uil:whatsapp" />
              <span>WhatsApp</span>
            </a>
          </li>
        </ul>
      </MenuItems>
    </Astronav>
    
    {/* 💻 XARXES SOCIALS - VERSIÓ ESCRIPTORI (Ocult en mòbils) */}
    <div class="hidden lg:flex items-center gap-1">
      <a 
        href="https://facebook.com/AEBLaPalma/" 
        target="_blank" 
        rel="noopener noreferrer" 
        title="Facebook"
        class="text-slate-500 hover:text-blue-600 transition-colors p-2"
      >
        <Icon class="w-5 h-5" name="uil:facebook" />
      </a>

      <a 
        href="https://instagram.com/aeblapalma" 
        target="_blank" 
        rel="noopener noreferrer" 
        title="Instagram"
        class="text-slate-500 hover:text-pink-600 transition-colors p-2"
      >
        <Icon class="w-5 h-5" name="uil:instagram" />
      </a>

      <a 
        href="https://tiktok.com/@aeblapalma" 
        target="_blank" 
        rel="noopener noreferrer" 
        title="TikTok"
        class="text-slate-500 hover:text-slate-950 transition-colors p-2"
      >
        <Icon class="w-5 h-5" name="uil:video" />
      </a>

      <a 
        href="https://wa.me/34644279680" 
        target="_blank" 
        rel="noopener noreferrer" 
        title="WhatsApp"
        class="text-slate-500 hover:text-green-500 transition-colors p-2"
      >
        <Icon class="w-5 h-5" name="uil:whatsapp" />
      </a>
    </div>
  </header>
</Container>