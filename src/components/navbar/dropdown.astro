---
import { Dropdown as MenuDropdown, DropdownItems } from "astro-navbar";

// 🌟 Afegim 'badge' a les propietats que rep el component
const { title, children, lastItem, path, badge } = Astro.props;
---

{/* 1. Afegim la classe 'group' a la llista per controlar el pas del ratolí */}
<li class="relative group">
  <MenuDropdown>
    
    <a
      href={path}
      class="flex items-center gap-1 w-full lg:w-auto lg:px-3 py-2 text-slate-600 hover:text-azulElectrico font-semibold transition-colors duration-200"
    >
      <span>{title}</span>

      {/* 🌟 Pintem la badge d'Estiu si s'ha activat al menú */}
      {badge && (
        <span class="ml-1 px-2 py-0.5 text-[9px] font-black uppercase text-azulOscuro bg-amarilloClub rounded-md shadow-sm shrink-0">
          Estiu
        </span>
      )}

      {/* Canviem group-open per group-hover a la fletxa perquè giri en passar el ratolí */}
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="3"
        stroke="currentColor"
        class="w-3 h-3 mt-0.5 text-gray-400 group-hover:text-azulElectrico group-hover:rotate-180 transition-all duration-200"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"></path>
      </svg>
    </a>

    {/* 2. Màgia de Tailwind: afegim 'lg:group-hover:block' perquè es mostri en passar el ratolí en pantalles grans */}
    <DropdownItems class="hidden lg:group-hover:block w-full lg:w-48 absolute z-50">
      <div class="lg:absolute lg:bg-white lg:shadow-md lg:rounded-md lg:border lg:border-gray-100 p-2 pl-4 lg:pl-2 space-y-1 bg-white left-0 top-full">
        {
          children.map((child) => (
            <a
              href={child.path}
              class="block py-2 text-slate-600 hover:text-azulElectrico font-medium text-sm transition-colors"
            >
              {child.title}
            </a>
          ))
        }
      </div>
    </DropdownItems>
  </MenuDropdown>
</li>