---
import { Picture } from "astro:assets";
import Link from "@/components/ui/link.astro";
import { Icon } from "astro-icon/components";
---

<main
  class="grid lg:grid-cols-2 place-items-center pt-16 pb-8 md:pt-12 md:pb-24">
  <div class="py-6 md:order-1 hidden md:block">
    <img 
      src="/logo.jpg" 
      alt="Escut oficial AEB La Palma" 
      class="w-full max-w-[600px] h-auto object-contain"
      loading="eager"
    />
  </div>
  <div>
    <h1
      class="text-5xl lg:text-6xl xl:text-7xl font-black lg:tracking-tight xl:tracking-tighter text-slate-50 uppercase">
      AEB LA PALMA: més que un club, una <span class="text-azulElectrico">família</span> a la pista
    </h1>
    <p class="text-lg mt-4 text-slate-300 max-w-xl">
      A l'AEB La Palma vivim el bàsquet des de la base fins al sènior. Formem esportistes, compartim valors i competim amb el cor a cada partit. Uneix-te al <span class="text-amarilloClub font-bold">groc</span>-i-<span class="text-azulElectrico font-bold">blau</span>!
    </p>
    
    <div class="mt-6 flex flex-col sm:flex-row gap-3">
      {/* 🌟 BOTÓ PRINCIPAL: Blau elèctric del club amb hover fosc */}
      <Link
        href="/equips"
        class="flex gap-2 items-center justify-center bg-azulElectrico hover:bg-azulOscuro text-white font-bold px-6 py-3 rounded-xl transition duration-200 shadow-md border border-azulElectrico/20"
        rel="noopener">
        <Icon class="text-white w-5 h-5" name="uil:basketball" />
        Equips
      </Link>
      
      {/* 🌟 BOTÓ SECUNDARI: Estil Outline que reacciona amb els colors del club */}
      <a
        href="/club"
        class="flex gap-2 items-center justify-center border-2 border-slate-700 hover:border-blue-400 bg-slate-900/40 text-slate-300 hover:text-blue-400 font-bold px-6 py-3 rounded-xl transition duration-200"
      >
        <Icon class="w-4 h-4" name="uil:dna" />
        Club
      </a>
    </div>
  </div>
</main>