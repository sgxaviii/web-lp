---
import Contactform from "@/components/contactform.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";
import Layout from "@/layouts/Layout.astro";
import { Icon } from "astro-icon/components";
---

<Layout title="Contact">
  <Container>
    <Sectionhead>
      <Fragment slot="title">Contacte</Fragment>
      <Fragment slot="desc">Estem aquí per ajudar-te.</Fragment>
    </Sectionhead>

    <div class="grid md:grid-cols-2 gap-10 mx-auto max-w-4xl mt-16">
      <div>
        <h2 class="font-medium text-2xl text-gray-800">Contacta amb nosaltres</h2>
        <p class="text-lg leading-relaxed text-slate-500 mt-3">
          Tens cap dubte? Contacta amb nosaltres fent servir aquest formulari, escriu-nos al WhatsApp o a l'adreça de 
          correu electrònic que tens just a sota.
        </p>
        <div class="mt-5 space-y-2">
          <a 
            href="https://www.google.com/maps/search/?api=1&query=Carrer+del+Canigo%2C+9%2C+08756+La+Palma+de+Cervello%2C+Barcelona%2C+Spain" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="flex items-center text-gray-600 hover:text-blue-600 transition-colors"
          >
            <Icon class="text-gray-400 w-4 h-4 shrink-0 mr-2" name="uil:map-marker" />
            <span>Carrer del Canigó, 9, 08756 La Palma de Cervelló, Barcelona, Spain</span>
          </a>

          <div class="flex items-center text-gray-600">
            <Icon class="text-gray-400 w-4 h-4 mr-2" name="uil:envelope" />
            <a href="mailto:sgxaviii@gmail.com" class="hover:text-blue-600 transition-colors">sgxaviii@gmail.com</a>
          </div>

          <div class="flex items-center text-gray-600">
            <Icon class="text-gray-400 w-4 h-4 mr-2" name="uil:phone" />
            <a href="tel:+34644279680" class="hover:text-blue-600 transition-colors">+34 644 27 96 80</a>
          </div>

          <a 
            href="https://www.instagram.com/aeblapalma/" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="flex items-center text-gray-600 hover:text-pink-600 transition-colors"
          >
            <Icon class="text-gray-400 w-4 h-4 shrink-0 mr-2" name="uil:instagram" />
            <span>@YOUR_USERNAME</span>
          </a>

          <a 
            href="https://www.facebook.com/AEBLaPalma/" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="flex items-center text-gray-600 hover:text-blue-700 transition-colors"
          >
            <Icon class="text-gray-400 w-4 h-4 shrink-0 mr-2" name="uil:facebook" />
            <span>Facebook Page Name</span>
          </a>
        </div>
      </div>
      <div>
        <Contactform />
      </div>
    </div>
  </Container>
</Layout>