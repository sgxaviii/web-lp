---
import Contactform from "@/components/contactform.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";
import Layout from "@/layouts/Layout.astro";
import { Icon } from "astro-icon/components";
---

<Layout title="Contact">
  <Container>
    <Sectionhead>
      {/* Títol estilitzat amb el groc corporatiu */}
      <Fragment slot="title">
        <span class="text-white">CONTACTE</span><span class="text-amarilloClub">.</span>
      </Fragment>
      <Fragment slot="desc">Estem aquí per ajudar-te. Troba'ns ràpidament.</Fragment>
    </Sectionhead>

    <div class="grid md:grid-cols-2 gap-12 mx-auto max-w-5xl mt-16 items-start">
      
      {/* COLUMNA ESQUERRA: Dades i blocs interactius */}
      <div class="space-y-6">
        <div>
          <h2 class="font-black text-2xl text-white uppercase tracking-wider">
            Contacta amb nosaltres
          </h2>
          <p class="text-base leading-relaxed text-slate-400 mt-3">
            Tens cap dubte sobre les inscripcions, equips o activitats? Fes servir el formulari o connecta directament a través dels nostres canals oficials.
          </p>
        </div>

        {/* CONTENIDOR DE BLOCS DE CONTACTE */}
        <div class="grid grid-cols-1 gap-3.5 pt-2">
          
          {/* Ubicació */}
          <a 
            href="https://www.google.com/maps/search/?api=1&query=Carrer+del+Canigo%2C+9%2C+08756+La+Palma+de+Cervello%2C+Barcelona%2C+Spain" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="flex items-center gap-4 p-3.5 rounded-2xl bg-slate-900/50 border border-slate-800/80 hover:border-azulElectrico hover:bg-slate-900 transition duration-200 group"
          >
            <div class="bg-slate-800 p-2.5 rounded-xl text-amarilloClub group-hover:bg-azulElectrico group-hover:text-white transition duration-200 shrink-0">
              <Icon class="w-5 h-5" name="uil:map-marker" />
            </div>
            <div class="flex flex-col min-w-0">
              <span class="text-xs text-slate-500 font-medium uppercase tracking-wider">Pavelló</span>
              <span class="text-sm text-slate-300 font-semibold group-hover:text-white transition truncate">Carrer del Canigó, 9, La Palma</span>
            </div>
          </a>

          {/* Email */}
          <a 
            href="mailto:sgxaviii@gmail.com" 
            class="flex items-center gap-4 p-3.5 rounded-2xl bg-slate-900/50 border border-slate-800/80 hover:border-azulElectrico hover:bg-slate-900 transition duration-200 group"
          >
            <div class="bg-slate-800 p-2.5 rounded-xl text-amarilloClub group-hover:bg-azulElectrico group-hover:text-white transition duration-200 shrink-0">
              <Icon class="w-5 h-5" name="uil:envelope" />
            </div>
            <div class="flex flex-col min-w-0">
              <span class="text-xs text-slate-500 font-medium uppercase tracking-wider">Correu electrònic</span>
              <span class="text-sm text-slate-300 font-semibold group-hover:text-white transition truncate">sgxaviii@gmail.com</span>
            </div>
          </a>

          {/* WhatsApp */}
          <a 
            href="https://wa.me/34644279680" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="flex items-center gap-4 p-3.5 rounded-2xl bg-slate-900/50 border border-slate-800/80 hover:border-emerald-600 hover:bg-slate-900 transition duration-200 group"
          >
            <div class="bg-slate-800 p-2.5 rounded-xl text-emerald-500 group-hover:bg-emerald-600 group-hover:text-white transition duration-200 shrink-0">
              <Icon class="w-5 h-5" name="uil:whatsapp" />
            </div>
            <div class="flex flex-col min-w-0">
              <span class="text-xs text-slate-500 font-medium uppercase tracking-wider">WhatsApp Club</span>
              <span class="text-sm text-slate-300 font-semibold group-hover:text-white transition truncate">+34 644 27 96 80</span>
            </div>
          </a>

          {/* Xarxes secundàries combinades en fila (Instagram, FB, TikTok, Twitter) */}
          <div class="grid grid-cols-4 gap-3 pt-1">
            <a 
              href="https://www.instagram.com/aeblapalma/" 
              target="_blank" 
              rel="noopener noreferrer" 
              title="Instagram"
              class="flex justify-center items-center p-4 rounded-xl bg-slate-900/50 border border-slate-800 hover:border-pink-500 text-slate-400 hover:text-pink-500 hover:bg-slate-900 transition duration-200"
            >
              <Icon class="w-6 h-6" name="uil:instagram" />
            </a>

            <a 
              href="https://www.facebook.com/AEBLaPalma/" 
              target="_blank" 
              rel="noopener noreferrer" 
              title="Facebook"
              class="flex justify-center items-center p-4 rounded-xl bg-slate-900/50 border border-slate-800 hover:border-blue-500 text-slate-400 hover:text-blue-500 hover:bg-slate-900 transition duration-200"
            >
              <Icon class="w-6 h-6" name="uil:facebook" />
            </a>

            <a 
              href="https://www.tiktok.com/@aeblapalma" 
              target="_blank" 
              rel="noopener noreferrer" 
              title="TikTok"
              class="flex justify-center items-center p-4 rounded-xl bg-slate-900/50 border border-slate-800 hover:border-red-500 text-slate-400 hover:text-red-500 hover:bg-slate-900 transition duration-200"
            >
              <Icon class="w-6 h-6" name="uil:bolt" />
            </a>

            <a 
              href="https://x.com/aeblapalma" 
              target="_blank" 
              rel="noopener noreferrer" 
              title="Twitter / X"
              class="flex justify-center items-center p-4 rounded-xl bg-slate-900/50 border border-slate-800 hover:border-sky-400 text-slate-400 hover:text-sky-400 hover:bg-slate-900 transition duration-200"
            >
              <Icon class="w-6 h-6" name="uil:twitter" />
            </a>
          </div>

        </div>
      </div>

      {/* COLUMNA DRETA: Formulari estilitzat fosc */}
      <div class="bg-slate-900/40 border border-slate-800 p-6 md:p-8 rounded-3xl shadow-xl shadow-slate-950/20">
        <Contactform />
      </div>

    </div>
  </Container>
</Layout>