---
// src/pages/botiga.astro
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";

// 🛍️ Enllaç al formulari general de comanda
const FORMULARI_BOTIGA_URL = "#formulari-comanda";

// 📸 Fotos del Carrusel d'Inspiració / Lookbook
const fotosCarrusel = [
  {
    url: "https://images.unsplash.com/photo-1515523110800-9415d13b84a8?q=80&w=1200&auto=format&fit=crop",
    titol: "Equipació Oficial de Joc",
    subtitol: "Dissenyada per al màxim rendiment a la pista",
  },
  {
    url: "https://images.unsplash.com/photo-1556906781-9a412961c28c?q=80&w=1200&auto=format&fit=crop",
    titol: "Col·lecció Streetwear Club",
    subtitol: "Lportat els nostres colors al carrer amb estil",
  },
  {
    url: "https://images.unsplash.com/photo-1517838277536-f5f99be501cd?q=80&w=1200&auto=format&fit=crop",
    titol: "Roba d'Entrenament",
    subtitol: "Comoditat i transpirabilitat per al teu dia a dia",
  },
];

// 👕 Catàleg de Productes del Club
const productes = [
  {
    id: "samarreta-joc",
    nom: "Samarreta Oficial de Joc",
    categoria: "Equipació",
    preu: "35,00 €",
    descripcio: "Samarreta oficial de competició de teixit tècnic transpirable. Inclou personalització de nom i dorsal.",
    fotoModel: "https://images.unsplash.com/photo-1574629810360-7efbbe195018?q=80&w=600&auto=format&fit=crop",
    fotoProducte: "https://images.unsplash.com/photo-1521572267360-ee0c2909d518?q=80&w=600&auto=format&fit=crop",
    linkFormulari: FORMULARI_BOTIGA_URL,
  },
  {
    id: "sudadera-carrer",
    nom: "Sudadera Hoodie Club",
    categoria: "Roba de Carrer",
    preu: "42,00 €",
    descripcio: "Sudadera amb caputxa i fons de cotó perxat d'alta qualitat. Amb el logo del club bordat al pit.",
    fotoModel: "https://images.unsplash.com/photo-1556905055-8f358a7a47b2?q=80&w=600&auto=format&fit=crop",
    fotoProducte: "https://images.unsplash.com/photo-1509967419530-da38b4704bc6?q=80&w=600&auto=format&fit=crop",
    linkFormulari: FORMULARI_BOTIGA_URL,
  },
  {
    id: "pantalons-curts",
    nom: "Pantalons de Joc",
    categoria: "Equipació",
    preu: "22,00 €",
    descripcio: "Pantalons curts d'alta mobilitat amb cintura elàstica i cordó d'ajust. Escut del club aplicat.",
    fotoModel: "https://images.unsplash.com/photo-1515523110800-9415d13b84a8?q=80&w=600&auto=format&fit=crop",
    fotoProducte: "https://images.unsplash.com/photo-1591195853828-11db59a44f6b?q=80&w=600&auto=format&fit=crop",
    linkFormulari: FORMULARI_BOTIGA_URL,
  },
  {
    id: "samarreta-cotó",
    nom: "Samarreta Casual Fan",
    categoria: "Roba de Carrer",
    preu: "18,00 €",
    descripcio: "Samarreta 100% cotó orgànic per animar a la lliga o per al dia a dia. Tallatge unisex.",
    fotoModel: "https://images.unsplash.com/photo-1503342217505-b0a15ec3261c?q=80&w=600&auto=format&fit=crop",
    fotoProducte: "https://images.unsplash.com/photo-1583743814966-8936f5b7be1a?q=80&w=600&auto=format&fit=crop",
    linkFormulari: FORMULARI_BOTIGA_URL,
  },
];
---

<Layout title="Tenda Oficial - CB Bàsquet">
  <Container>
    <div class="mt-14 relative z-10">
      
      {/* Capçalera */}
      <Sectionhead>
        <Fragment slot="title">
          <span class="text-slate-50 uppercase tracking-tight font-black">Tenda Oficial</span>
        </Fragment>
        <Fragment slot="desc">
          <span class="text-gray-400 text-lg block">
            Equipa't amb els colors del club: des de la roba de joc fins a la col·lecció streetwear.
          </span>
        </Fragment>
      </Sectionhead>

      {/* 🎠 SECCIÓ: Carrusel d'imatges de models (Lookbook) */}
      <section class="mt-10 mb-20 max-w-6xl mx-auto relative group">
        <div class="relative h-[380px] sm:h-[480px] md:h-[550px] w-full overflow-hidden rounded-3xl border border-slate-800 shadow-2xl bg-slate-950">
          {
            fotosCarrusel.map((item, index) => (
              <div
                class={`carrusel-slide absolute inset-0 transition-opacity duration-700 ease-in-out ${index === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0'}`}
                data-slide={index}
              >
                <img
                  src={item.url}
                  alt={item.titol}
                  class="w-full h-full object-cover opacity-80"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/30 to-transparent flex flex-col justify-end p-6 sm:p-12">
                  <span class="bg-amarilloClub text-azulOscuro font-black text-xs uppercase tracking-widest px-3 py-1 rounded-md w-fit mb-2">
                    Col·lecció Oficial
                  </span>
                  <h2 class="text-2xl sm:text-4xl font-black text-white uppercase tracking-tight">
                    {item.titol}
                  </h2>
                  <p class="text-gray-300 text-sm sm:text-base mt-1">
                    {item.subtitol}
                  </p>
                </div>
              </div>
            ))
          }

          {/* Botons de navegació del carrusel */}
          <button
            id="prevBtn"
            class="absolute left-4 top-1/2 -translate-y-1/2 z-20 bg-slate-900/80 hover:bg-amarilloClub hover:text-azulOscuro text-white p-3 rounded-full border border-slate-700 transition duration-200"
            aria-label="Anterior"
          >
            ←
          </button>
          <button
            id="nextBtn"
            class="absolute right-4 top-1/2 -translate-y-1/2 z-20 bg-slate-900/80 hover:bg-amarilloClub hover:text-azulOscuro text-white p-3 rounded-full border border-slate-700 transition duration-200"
            aria-label="Següent"
          >
            →
          </button>
        </div>
      </section>

      {/* 🛍️ SECCIÓ: Catàleg de Productes */}
      <main class="mb-20 max-w-6xl mx-auto">
        <div class="mb-10 border-b border-slate-800 pb-4 flex flex-col sm:flex-row justify-between items-start sm:items-end gap-4">
          <div>
            <h2 class="text-3xl font-black text-white uppercase tracking-tight">Catàleg de Productes</h2>
            <p class="text-gray-400 text-sm mt-1">Selecciona una peça de roba per encarregar-la a través del formulari.</p>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {
            productes.map((producte) => (
              <div class="bg-slate-900/60 rounded-3xl border border-slate-800 overflow-hidden shadow-xl hover:border-amarilloClub transition duration-300 flex flex-col justify-between">
                
                {/* Visualitzador de fotografies (Model / Peça) */}
                <div class="p-4">
                  <div class="relative aspect-4/3 rounded-2xl overflow-hidden bg-slate-950 border border-slate-800">
                    
                    {/* Imatge Model */}
                    <img
                      id={`img-model-${producte.id}`}
                      src={producte.fotoModel}
                      alt={`${producte.nom} - Foto amb Model`}
                      class="w-full h-full object-cover absolute inset-0 transition-opacity duration-300 opacity-100"
                    />

                    {/* Imatge Producte sol */}
                    <img
                      id={`img-producte-${producte.id}`}
                      src={producte.fotoProducte}
                      alt={`${producte.nom} - Vista del producte`}
                      class="w-full h-full object-cover absolute inset-0 transition-opacity duration-300 opacity-0"
                    />

                    {/* Etiqueta Categoria */}
                    <span class="absolute top-3 left-3 z-10 bg-slate-950/80 border border-slate-700 text-gray-200 text-[10px] font-black uppercase tracking-wider px-2.5 py-1 rounded-md">
                      {producte.categoria}
                    </span>

                    {/* Selector per canviar la vista de la foto */}
                    <div class="absolute bottom-3 right-3 z-10 bg-slate-950/90 border border-slate-800 rounded-xl p-1 flex gap-1 shadow-lg">
                      <button
                        data-target={producte.id}
                        data-type="model"
                        class="toggle-foto-btn text-xs font-bold px-3 py-1 rounded-lg bg-amarilloClub text-azulOscuro transition"
                      >
                        Model
                      </button>
                      <button
                        data-target={producte.id}
                        data-type="producte"
                        class="toggle-foto-btn text-xs font-bold px-3 py-1 rounded-lg text-gray-400 hover:text-white transition"
                      >
                        Producte
                      </button>
                    </div>

                  </div>
                </div>

                {/* Informació i Preu */}
                <div class="p-6 pt-2 flex-grow flex flex-col justify-between">
                  <div>
                    <div class="flex justify-between items-start gap-4 mb-2">
                      <h3 class="text-xl font-black text-white uppercase tracking-tight">
                        {producte.nom}
                      </h3>
                      <span class="text-xl font-black text-amarilloClub whitespace-nowrap">
                        {producte.preu}
                      </span>
                    </div>

                    <p class="text-gray-400 text-sm leading-relaxed mb-6">
                      {producte.descripcio}
                    </p>
                  </div>

                  {/* Botó de comanda que baixa fins al formulari encastat */}
                  <a
                    href={producte.linkFormulari}
                    class="w-full text-center bg-azulElectrico hover:bg-azulOscuro text-white font-black uppercase tracking-wider py-3 px-6 rounded-xl shadow-md transition duration-200 border border-azulElectrico/20 flex items-center justify-center gap-2"
                  >
                    <span>🛒 Encarregar peça</span>
                    <span class="text-xs opacity-75">↓</span>
                  </a>
                </div>

              </div>
            ))
          }
        </div>
        {/* 📝 SECCIÓ: Formulari de Comanda Encastat */}
        <section id="formulari-comanda" class="mt-16 max-w-4xl mx-auto scroll-mt-24">
          <div class="bg-slate-900/80 border border-slate-800 rounded-3xl p-6 md:p-8 shadow-2xl backdrop-blur-sm">
            
            <div class="text-center mb-8">
              <span class="bg-amarilloClub text-azulOscuro font-black text-xs uppercase tracking-widest px-3 py-1 rounded-md">
                Comanda Online
              </span>
              <h2 class="text-2xl md:text-3xl font-black text-white uppercase tracking-tight mt-3">
                Formulari d'Encarrec
              </h2>
              <p class="text-gray-400 text-sm mt-2">
                Emplena el següent formulari amb les dades de contacte, la peça i la talla que necessites.
              </p>
            </div>

            {/* Contenidor de l'Iframe optimitzat i adaptable */}
            <div class="w-full overflow-hidden rounded-2xl bg-white border border-slate-700 shadow-inner">
              <iframe
                src="https://docs.google.com/forms/d/e/1FAIpQLSeh38DXJ9ndo4bgIYl4bkijXIgDeF8fMJrdAVXswy4RRvvyuQ/viewform?embedded=true"
                class="w-full h-[1800px] md:h-[2200px] border-0"
                loading="lazy"
              >
                S'està carregant…
              </iframe>
            </div>

          </div>
        </section>
      </main>

    </div>
  </Container>
</Layout>

{/* Lògica interactiva per al Carrusel i el Selector d'Imatges */}
<script is:inline>
  // 1. Lògica del Carrusel de fotos
  const slides = document.querySelectorAll('.carrusel-slide');
  let currentSlide = 0;

  function showSlide(index) {
    slides.forEach((slide, i) => {
      if (i === index) {
        slide.classList.remove('opacity-0', 'z-0');
        slide.classList.add('opacity-100', 'z-10');
      } else {
        slide.classList.remove('opacity-100', 'z-10');
        slide.classList.add('opacity-0', 'z-0');
      }
    });
  }

  document.getElementById('nextBtn')?.addEventListener('click', () => {
    currentSlide = (currentSlide + 1) % slides.length;
    showSlide(currentSlide);
  });

  document.getElementById('prevBtn')?.addEventListener('click', () => {
    currentSlide = (currentSlide - 1 + slides.length) % slides.length;
    showSlide(currentSlide);
  });

  // Carrusel automàtic cada 5 segons
  setInterval(() => {
    currentSlide = (currentSlide + 1) % slides.length;
    showSlide(currentSlide);
  }, 5000);

  // 2. Lògica per alternar entre foto de Model i foto de Producte
  const toggleBtns = document.querySelectorAll('.toggle-foto-btn');

  toggleBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const targetId = btn.getAttribute('data-target');
      const type = btn.getAttribute('data-type');

      const imgModel = document.getElementById(`img-model-${targetId}`);
      const imgProducte = document.getElementById(`img-producte-${targetId}`);

      const parent = btn.parentElement;
      const buttons = parent.querySelectorAll('.toggle-foto-btn');

      // Resetejar estil de botons
      buttons.forEach((b) => {
        b.classList.remove('bg-amarilloClub', 'text-azulOscuro');
        b.classList.add('text-gray-400');
      });

      // Activar botó clicat
      btn.classList.add('bg-amarilloClub', 'text-azulOscuro');
      btn.classList.remove('text-gray-400');

      // Alternar visibilitat de la imatge
      if (type === 'model') {
        imgModel.classList.remove('opacity-0');
        imgModel.classList.add('opacity-100');
        imgProducte.classList.remove('opacity-100');
        imgProducte.classList.add('opacity-0');
      } else {
        imgProducte.classList.remove('opacity-0');
        imgProducte.classList.add('opacity-100');
        imgModel.classList.remove('opacity-100');
        imgModel.classList.add('opacity-0');
      }
    });
  });
</script>