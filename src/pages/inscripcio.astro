---
// src/pages/inscripcions.astro
import { sanityClient } from "sanity:client";
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";

// 📧 Dades de contacte i enllaços oficials
const EMAIL_CLUB = "info@aeblapalma.cat";
const WHATSAPP_NUM = "644 27 96 80";
const WHATSAPP_NOM = "Jofre";
const WHATSAPP_LINK = "https://wa.me/34644279680?text=Hola!%20Vull%20enviar%20la%20documentaci%C3%B3%20d'inscripci%C3%B3";
const FORMULARI_DRETS_IMATGE = "https://forms.gle/DjeHuUuAuNynWgDv7";
const INSTAGRAM_USER = "@aeblapalma";
const INSTAGRAM_LINK = "https://www.instagram.com/aeblapalma";

// 📄 Rutes per defecte dels PDFs generals
const PDF_INSCRIPCIO_DEFAULT = "/assets/full-inscripcio.pdf";
const PDF_RENUNCIA_DEFAULT = "/assets/renuncia-fitxa-federativa.pdf";
const PDF_RECOLLIDA_DEFAULT = "/assets/autoritzacio-recollida-menors.pdf";

// 🌟 Demanem els equips a Sanity incloent els camps de form i PDFs
const totsElsEquips = await sanityClient.fetch(`*[_type == "equip"] | order(posicio asc){
  _id,
  nom,
  categoria,
  linkFormulari,
  "pdfUrl": pdfInscripcio.asset->url,
  "pdfRenunciaUrl": pdfRenuncia.asset->url,
  "pdfRecollidaUrl": pdfRecollida.asset->url
}`);

// 🧠 Funció auxiliar per determinar si un equip requereix full de recollida de menors
function esEquipMenors(equipo) {
  const text = `${equipo.categoria || ""} ${equipo.nom || ""}`.toLowerCase();
  const categoriesAdults = [
    "sots 25", "sots-25", "sots25",
    "senior", "sènior",
    "veterans", "veteran",
    "més que bàsquet", "mes que basquet", "mqb"
  ];
  
  // Retorna true si NO inclou cap de les categories d'adults
  return !categoriesAdults.some((cat) => text.includes(cat));
}
---

<Layout title="Inscripcions - AEB La Palma">
  <Container>
    <div class="mt-14 relative z-10">
      
      {/* Capçalera de benvinguda */}
      <Sectionhead>
        <Fragment slot="title">
          <span class="text-slate-50 uppercase tracking-tight font-black">Inscripcions AEB La Palma</span>
        </Fragment>
        <Fragment slot="desc">
          <span class="text-amarilloClub font-bold text-xl block mb-2">
            Benvingut/da al club, estem molt contents de rebre’t! 💙💛
          </span>
          <span class="text-gray-400 text-base block">
            Formalitzar la teva inscripció és molt senzill. Segueix els passos següents per completar el procés.
          </span>
        </Fragment>
      </Sectionhead>

      {/* 📋 SECCIÓ 1: Procés pas a pas d'inscripció */}
      <section class="mt-10 mb-12 max-w-5xl mx-auto">
        <div class="bg-slate-900/80 border border-slate-800 rounded-3xl p-6 md:p-8 shadow-2xl backdrop-blur-sm">
          <h2 class="text-xl md:text-2xl font-black text-white uppercase tracking-tight mb-6 flex items-center gap-3">
            <span class="text-amarilloClub">📌</span> Passos per a la Inscripció
          </h2>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            
            <!-- Pas 1: Drets d'imatge -->
            <div class="bg-slate-950/70 p-5 rounded-2xl border border-slate-800/80 flex flex-col justify-between group hover:border-amarilloClub/50 transition duration-300">
              <div>
                <span class="inline-block bg-amarilloClub/20 text-amarilloClub border border-amarilloClub/30 font-black text-xs px-3 py-1 rounded-full mb-3">
                  PAS 1
                </span>
                <h3 class="text-white font-bold text-base mb-2">Drets d'Imatge</h3>
                <p class="text-gray-400 text-sm leading-relaxed mb-4">
                  Omple el formulari d'autorització per a l'ús d'imatges i promocions de les nostres activitats.
                </p>
              </div>
              <a
                href={FORMULARI_DRETS_IMATGE}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full text-center bg-amarilloClub hover:bg-yellow-400 text-azulOscuro font-bold py-2 px-4 rounded-xl text-xs transition duration-200 flex items-center justify-center gap-1.5 shadow-md"
              >
                <span>📝 Formulari d'Imatge</span>
                <span>↗</span>
              </a>
            </div>

            <!-- Pas 2: Descarregar documents -->
            <div class="bg-slate-950/70 p-5 rounded-2xl border border-slate-800/80 flex flex-col justify-between group hover:border-azulElectrico/50 transition duration-300">
              <div>
                <span class="inline-block bg-azulElectrico/20 text-azulElectrico border border-azulElectrico/30 font-black text-xs px-3 py-1 rounded-full mb-3">
                  PAS 2
                </span>
                <h3 class="text-white font-bold text-base mb-2">Tria Equip i Descarrega</h3>
                <p class="text-gray-400 text-sm leading-relaxed">
                  Cerca el teu equip a la llista de baix, descarrega els documents corresponents i emplena'ls.
                </p>
              </div>
              <span class="text-xs text-azulElectrico font-semibold mt-4">↓ Veure equips a la secció inferior</span>
            </div>

            <!-- Pas 3: Enviar la documentació -->
            <div class="bg-slate-950/70 p-5 rounded-2xl border border-slate-800/80 flex flex-col justify-between group hover:border-emerald-500/50 transition duration-300">
              <div>
                <span class="inline-block bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 font-black text-xs px-3 py-1 rounded-full mb-3">
                  PAS 3
                </span>
                <h3 class="text-white font-bold text-base mb-2">Envia els Documents</h3>
                <p class="text-gray-400 text-sm leading-relaxed">
                  Envia tots els documents escanejats o fotografiats per correu electrònic o WhatsApp.
                </p>
              </div>
              <span class="text-xs text-emerald-400 font-semibold mt-4">✉️ Email o WhatsApp disponibles</span>
            </div>

          </div>

          <!-- 📬 Destacat de canals de recepció de documents -->
          <div class="mt-8 pt-6 border-t border-slate-800 grid grid-cols-1 md:grid-cols-2 gap-4">
            
            {/* Opcio Correu */}
            <div class="bg-slate-950 border border-slate-800 rounded-xl p-4 flex items-center justify-between gap-3">
              <div>
                <p class="text-[11px] font-bold uppercase tracking-wider text-gray-400">Opció A: Via Correu Electrònic</p>
                <p class="text-white font-mono font-bold text-sm md:text-base mt-0.5">{EMAIL_CLUB}</p>
              </div>
              <a
                href={`mailto:${EMAIL_CLUB}?subject=Inscripció%20AEB%20La%20Palma`}
                class="bg-slate-800 hover:bg-slate-700 text-white font-bold px-3.5 py-2 rounded-xl text-xs transition duration-200 shrink-0 border border-slate-700"
              >
                ✉️ Enviar Mail
              </a>
            </div>

            {/* Opcio WhatsApp */}
            <div class="bg-slate-950 border border-emerald-500/30 rounded-xl p-4 flex items-center justify-between gap-3">
              <div>
                <p class="text-[11px] font-bold uppercase tracking-wider text-emerald-400">Opció B: Via WhatsApp ({WHATSAPP_NOM})</p>
                <p class="text-white font-mono font-bold text-sm md:text-base mt-0.5">+34 {WHATSAPP_NUM}</p>
              </div>
              <a
                href={WHATSAPP_LINK}
                target="_blank"
                rel="noopener noreferrer"
                class="bg-emerald-600 hover:bg-emerald-500 text-white font-bold px-3.5 py-2 rounded-xl text-xs transition duration-200 shrink-0"
              >
                💬 WhatsApp
              </a>
            </div>

          </div>
        </div>
      </section>

      {/* ⚠️ SECCIÓ 2: Requisits de la fitxa i aclariments específics */}
      <section class="mb-16 max-w-5xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          
          <!-- Bloc Requisits Fitxa Federativa -->
          <div class="md:col-span-1 bg-slate-900/90 border border-amarilloClub/40 rounded-3xl p-6 shadow-xl flex flex-col justify-between">
            <div>
              <div class="flex items-center gap-2 mb-3">
                <span class="text-xl">🪪</span>
                <h3 class="text-lg font-black text-white uppercase tracking-tight">Fitxa Federativa</h3>
              </div>
              <p class="text-gray-300 text-xs leading-relaxed mb-4">
                Per tramitar la fitxa federativa oficial, a part dels documents d’inscripció, és imprescindible aportar:
              </p>
              <ul class="space-y-2 text-xs text-gray-200">
                <li class="flex items-center gap-2">
                  <span class="text-amarilloClub font-bold">✓</span>
                  <span><strong>Foto tipus carnet</strong> recent.</span>
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-amarilloClub font-bold">✓</span>
                  <span><strong>DNI</strong> i <strong>Targeta Sanitària</strong> escanejats.</span>
                </li>
              </ul>
            </div>
            <div class="mt-6 pt-4 border-t border-slate-800 text-[11px] text-gray-400 italic">
              Recorda adjuntar aquesta documentació al teu missatge.
            </div>
          </div>

          <!-- Bloc Aclariments per Categoria -->
          <div class="md:col-span-2 bg-slate-900/80 border border-slate-800 rounded-3xl p-6 shadow-xl">
            <h3 class="text-lg font-black text-white uppercase tracking-tight mb-4 flex items-center gap-2">
              <span>ℹ️</span> Aclariments Específics per Categoria
            </h3>

            <div class="space-y-4 text-xs text-gray-300">
              
              {/* Preminis */}
              <div class="p-3.5 bg-slate-950/80 rounded-xl border border-slate-800">
                <p class="font-bold text-white text-sm mb-1 text-amarilloClub">🏀 Preminis</p>
                <p>
                  El <em>"Document de Renúncia a la Fitxa Federativa"</em> és <strong>obligatori sempre que no vulgueu federar</strong> al jugador/a. La fitxa té un cost de <strong>50 €</strong> i els habilita a jugar partits i a estar coberts per la Mútua de la Federació. Podeu federar l’infant sense participar dels partits per gaudir de la cobertura mèdica.
                </p>
              </div>

              {/* Veterans */}
              <div class="p-3.5 bg-slate-950/80 rounded-xl border border-slate-800">
                <p class="font-bold text-white text-sm mb-1 text-amarilloClub">🏀 Veterans</p>
                <p>
                  El <em>"Document de Renúncia a la Fitxa Federativa"</em> és <strong>obligatori llevat que vulgueu federar-vos</strong> per accedir a la cobertura mèdica de la federació. La fitxa té un cost d’uns <strong>35 €</strong> i té vigència des de l’01/09 fins al 30/06.
                </p>
              </div>

              {/* Més Que Bàsquet */}
              <div class="p-3.5 bg-slate-950/80 rounded-xl border border-slate-800">
                <p class="font-bold text-white text-sm mb-1 text-amarilloClub">🏀 Més Que Bàsquet</p>
                <p>
                  El <em>"Document de Renúncia a la Fitxa Federativa"</em> és <strong>obligatori llevat que vulgueu federar-vos</strong> per accedir a la cobertura mèdica de la federació. La fitxa té un cost d’uns <strong>35 €</strong> i té vigència des de l’01/09 fins al 30/06.
                </p>
              </div>

            </div>
          </div>

        </div>
      </section>

      {/* 🏀 SECCIÓ 3: Graella de Targetes d'Equips */}
      <main class="mb-20">
        <div class="max-w-6xl mx-auto mb-8">
          <h2 class="text-2xl font-black text-white uppercase tracking-tight">Equips i Activitats</h2>
          <p class="text-gray-400 text-sm mt-1">Selecciona el teu equip per accedir al formulari online i descarregar la documentació corresponent.</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 max-w-6xl mx-auto">
          {
            totsElsEquips && totsElsEquips.map((equipo) => {
              const googleFormUrl = equipo.linkFormulari || "#";
              const pdfInscripcio = equipo.pdfUrl || PDF_INSCRIPCIO_DEFAULT;
              const pdfRenuncia = equipo.pdfRenunciaUrl || PDF_RENUNCIA_DEFAULT;
              const pdfRecollida = equipo.pdfRecollidaUrl || PDF_RECOLLIDA_DEFAULT;
              const requereixRecollida = esEquipMenors(equipo);

              return (
                <div class="bg-slate-900/60 rounded-2xl shadow-lg border border-slate-800 overflow-hidden group hover:border-amarilloClub transition-all duration-300 flex flex-col justify-between p-5">
                  
                  {/* Capçalera de la targeta */}
                  <div>
                    {equipo.categoria && (
                      <span class="inline-block bg-amarilloClub text-azulOscuro uppercase tracking-wider text-[10px] font-black px-2.5 py-1 rounded-md shadow-md mb-2.5">
                        {equipo.categoria}
                      </span>
                    )}

                    <h3 class="text-xl font-black text-white uppercase tracking-tight group-hover:text-amarilloClub transition-colors duration-200">
                      {equipo.nom}
                    </h3>
                  </div>

                  {/* Llista de botons de descàrrega i formulari */}
                  <div class="mt-6 flex flex-col gap-2.5">
                    
                    {/* 1. Formulari Google (si existeix) */}
                    {equipo.linkFormulari && (
                      <a
                        href={googleFormUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="w-full text-center bg-azulElectrico hover:bg-azulOscuro text-white font-bold py-2 px-3 rounded-xl text-xs shadow-md transition duration-200 border border-azulElectrico/20 flex items-center justify-center gap-2"
                      >
                        <span>📝</span>
                        <span>Formulari online</span>
                        <span class="text-[10px] opacity-70">↗</span>
                      </a>
                    )}

                    {/* 2. PDF Full d'Inscripció */}
                    <a
                      href={pdfInscripcio}
                      download
                      target="_blank"
                      rel="noopener noreferrer"
                      class="w-full text-center bg-slate-800 hover:bg-slate-700 text-gray-200 hover:text-white font-semibold py-2 px-3 rounded-xl text-xs transition duration-200 border border-slate-700 flex items-center justify-center gap-2"
                    >
                      <span>📄</span>
                      <span>PDF Inscripció</span>
                    </a>

                    {/* 3. PDF Renúncia Fitxa Federativa */}
                    <a
                      href={pdfRenuncia}
                      download
                      target="_blank"
                      rel="noopener noreferrer"
                      class="w-full text-center bg-slate-800/80 hover:bg-slate-700 text-gray-300 hover:text-white font-semibold py-2 px-3 rounded-xl text-xs transition duration-200 border border-slate-700/70 flex items-center justify-center gap-2"
                    >
                      <span>📋</span>
                      <span>Renúncia Fitxa Federativa</span>
                    </a>

                    {/* 4. PDF Recollida de Menors (Només si no és equip d'adults) */}
                    {requereixRecollida && (
                      <a
                        href={pdfRecollida}
                        download
                        target="_blank"
                        rel="noopener noreferrer"
                        class="w-full text-center bg-amber-500/10 hover:bg-amber-500/20 text-amber-300 hover:text-amber-200 font-semibold py-2 px-3 rounded-xl text-xs transition duration-200 border border-amber-500/30 flex items-center justify-center gap-2"
                      >
                        <span>🚸</span>
                        <span>Autorització Recollida</span>
                      </a>
                    )}

                  </div>

                </div>
              );
            })
          }
        </div>
      </main>

      {/* 📲 Banner Instagram d'Acomiadament */}
      <section class="max-w-4xl mx-auto mb-16 text-center">
        <div class="bg-gradient-to-r from-slate-900 via-slate-900/90 to-slate-900 border border-slate-800 rounded-3xl p-8 shadow-xl">
          <p class="text-white text-xl font-black uppercase tracking-tight mb-2">
            Benvingut/da a la família de l'AEB La Palma! 💙💛
          </p>
          <p class="text-gray-400 text-sm mb-6">
            No oblidis seguir-nos a les xarxes socials per estar al dia de tota l'actualitat i partits del club.
          </p>
          <a
            href={INSTAGRAM_LINK}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 bg-gradient-to-r from-purple-600 via-pink-600 to-yellow-500 text-white font-bold px-6 py-3 rounded-full text-sm hover:opacity-90 transition duration-200 shadow-lg"
          >
            <span>📸 Segueix-nos a Instagram {INSTAGRAM_USER}</span>
            <span>↗</span>
          </a>
        </div>
      </section>

    </div>
  </Container>
</Layout>