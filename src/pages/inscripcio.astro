---
// src/pages/inscripcions.astro
import { sanityClient } from "sanity:client";
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";

// 📧 Correu electrònic del club per enviar les inscripcions
const EMAIL_CLUB = "info@aeblapalma.cat";

// 📄 PDF general per defecte (en cas que no n'hi hagi un de específic per equip)
const PDF_GENERAL_URL = "/assets/full-inscripcio.pdf";

// 🌟 Demanem els equips a Sanity incloent els camps del formulari i PDF
const totsElsEquips = await sanityClient.fetch(`*[_type == "equip"] | order(posicio asc){
  _id,
  nom,
  categoria,
  linkFormulari,
  "pdfUrl": pdfInscripcio.asset->url
}`);
---

<Layout title="Inscripcions - CB Bàsquet">
  <Container>
    <div class="mt-14 relative z-10">
      
      {/* Capçalera */}
      <Sectionhead>
        <Fragment slot="title">
          <span class="text-slate-50 uppercase tracking-tight font-black">Inscripcions Temporada</span>
        </Fragment>
        <Fragment slot="desc">
          <span class="text-gray-400 text-lg block">
            Forma part del nostre club. Segueix el procés pas a pas per formalitzar la teva plaça.
          </span>
        </Fragment>
      </Sectionhead>

      {/* Secció: Procés pas a pas d'inscripció */}
      <section class="mt-10 mb-16 max-w-4xl mx-auto">
        <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-6 md:p-8 shadow-2xl backdrop-blur-sm">
          <h2 class="text-xl md:text-2xl font-black text-white uppercase tracking-tight mb-6 flex items-center gap-3">
            <span class="text-amarilloClub">📋</span> Procés d'Inscripció
          </h2>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <!-- Pas 1 -->
            <div class="bg-slate-950/60 p-5 rounded-xl border border-slate-800/80 flex flex-col justify-between">
              <div>
                <span class="inline-block bg-azulElectrico/20 text-azulElectrico border border-azulElectrico/30 font-black text-xs px-3 py-1 rounded-full mb-3">PAS 1</span>
                <h3 class="text-white font-bold text-base mb-2">Omple el Formulari</h3>
                <p class="text-gray-400 text-sm">
                  Busca el teu equip a la llista inferior i completa el formulari de Google amb les teves dades.
                </p>
              </div>
            </div>

            <!-- Pas 2 -->
            <div class="bg-slate-950/60 p-5 rounded-xl border border-slate-800/80 flex flex-col justify-between">
              <div>
                <span class="inline-block bg-amarilloClub/20 text-amarilloClub border border-amarilloClub/30 font-black text-xs px-3 py-1 rounded-full mb-3">PAS 2</span>
                <h3 class="text-white font-bold text-base mb-2">Descarrega el PDF</h3>
                <p class="text-gray-400 text-sm">
                  Descarrega el document oficial en PDF, imprimeix-lo i signa les autoritzacions corresponents.
                </p>
              </div>
            </div>

            <!-- Pas 3 -->
            <div class="bg-slate-950/60 p-5 rounded-xl border border-slate-800/80 flex flex-col justify-between">
              <div>
                <span class="inline-block bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 font-black text-xs px-3 py-1 rounded-full mb-3">PAS 3</span>
                <h3 class="text-white font-bold text-base mb-2">Envia la Documentació</h3>
                <p class="text-gray-400 text-sm">
                  Escaneja o fotografia el full PDF omplert i envia'l al correu del club per finalitzar la reserva.
                </p>
              </div>
            </div>
          </div>

          <!-- Destacat del correu d'enviament -->
          <div class="mt-8 bg-slate-950 border border-amarilloClub/40 rounded-xl p-5 text-center flex flex-col sm:flex-row items-center justify-between gap-4">
            <div class="text-left">
              <p class="text-xs font-bold uppercase tracking-wider text-amarilloClub">On s'ha d'enviar el document PDF emplenat?</p>
              <p class="text-white font-mono font-bold text-lg md:text-xl">{EMAIL_CLUB}</p>
            </div>
            <a
              href={`mailto:${EMAIL_CLUB}?subject=Inscripció%20Temporada`}
              class="bg-amarilloClub hover:bg-yellow-400 text-azulOscuro font-black px-5 py-2.5 rounded-xl text-sm transition-all duration-200 shrink-0 shadow-md"
            >
              ✉️ Enviar correu ara
            </a>
          </div>
        </div>
      </section>

      {/* Secció: Gria de Targetes d'Equips */}
      <main class="mb-20">
        <div class="max-w-6xl mx-auto mb-8">
          <h2 class="text-2xl font-black text-white uppercase tracking-tight">Equips Disponibles</h2>
          <p class="text-gray-400 text-sm mt-1">Selecciona el teu equip per accedir al formulari i descarregar el full d'inscripció.</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 max-w-6xl mx-auto">
          {
            totsElsEquips && totsElsEquips.map((equipo) => {
              const googleFormUrl = equipo.linkFormulari || "#";
              const pdfUrl = equipo.pdfUrl || PDF_GENERAL_URL;

              return (
                <div class="bg-slate-900/60 rounded-2xl shadow-lg border border-slate-800 overflow-hidden group hover:border-amarilloClub transition-all duration-300 flex flex-col justify-between p-6">
                  
                  {/* Capçalera de la targeta */}
                  <div>
                    {equipo.categoria && (
                      <span class="inline-block bg-amarilloClub text-azulOscuro uppercase tracking-wider text-[10px] font-black px-2.5 py-1 rounded-md shadow-md mb-3">
                        {equipo.categoria}
                      </span>
                    )}

                    <h3 class="text-xl font-black text-white uppercase tracking-tight group-hover:text-amarilloClub transition-colors duration-200">
                      {equipo.nom}
                    </h3>
                  </div>

                  {/* Botons d'acció */}
                  <div class="mt-8 flex flex-col gap-3">
                    <a
                      href={googleFormUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="w-full text-center bg-azulElectrico hover:bg-azulOscuro text-white font-bold py-2.5 px-4 rounded-xl text-sm shadow-md transition duration-200 border border-azulElectrico/20 flex items-center justify-center gap-2"
                    >
                      <span>📝</span>
                      <span>Formulari de Google</span>
                      <span class="text-xs opacity-70">↗</span>
                    </a>

                    <a
                      href={pdfUrl}
                      download
                      target="_blank"
                      rel="noopener noreferrer"
                      class="w-full text-center bg-slate-800 hover:bg-slate-700 text-gray-200 hover:text-white font-bold py-2.5 px-4 rounded-xl text-sm transition duration-200 border border-slate-700 flex items-center justify-center gap-2"
                    >
                      <span>📄</span>
                      <span>Descarregar PDF</span>
                    </a>
                  </div>

                </div>
              );
            })
          }
        </div>
      </main>

    </div>
  </Container>
</Layout>