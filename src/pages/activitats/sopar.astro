---
// src/pages/sopar.astro
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import { Icon } from "astro-icon/components";

// 🌟 Importem el client de Sanity i el constructor d'URLs d'imatges
import { sanityClient } from "sanity:client";
import imageUrlBuilder from "@sanity/image-url";

// Inicialitzem el builder de Sanity per poder renderitzar les fotos de la galeria
const builder = imageUrlBuilder(sanityClient);
function urlFor(source) {
  return builder.image(source);
}

// 🌟 CONSULTA: Demanem totes les dades configurades a l'esquema "sopar"
const dadesSopar = await sanityClient.fetch(
  `*[_type == "sopar"][0]{
    datesSopar,
    hora,
    lloc,
    preuAdult,
    preuInfantil,
    dataLimitInscripcio,
    menuAdult,
    menuInfantil,
    fotosAnysPassats[]{
      asset,
      alt
    },
    linkMaps,
    linkInscripcio
  }`
);

// Valors de contingut per defecte (fallback) en cas de base de dades buida o error
const {
  datesSopar = "Dissabte, 20 de Juny de 2026",
  hora = "A partir de les 21:00h",
  lloc = "Pistes Exteriors del Club (en cas de pluja, al Pavelló Cobert)",
  preuAdult = "22€",
  preuInfantil = "12€ (fins a 12 anys)",
  dataLimitInscripcio = "14 de Juny de 2026",
  menuAdult = [],
  menuInfantil = [],
  fotosAnysPassats = [],
  linkMaps = "",
  linkInscripcio = "https://docs.google.com/forms/"
} = dadesSopar || {};

// 🌟 LÒGICA DE MAPS: Si no hi ha enllaç de Maps definit, creem una cerca automàtica amb la ubicació escrit
const googleMapsUrl = linkMaps || `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(lloc)}`;
---

<Layout title="Sopar de Final de Temporada - AEB La Palma">
  <Container>
    <div class="mt-14 relative z-10">
      
      {/* =========================================
          HERO DE LA PÀGINA
      ========================================= */}
      <section class="text-center max-w-3xl mx-auto pt-8 pb-12">
        <span class="bg-amarilloClub text-azulOscuro uppercase tracking-wider text-xs font-black px-3 py-1 rounded-full shadow-sm">
          Festa del Club • Tancament de Temporada
        </span>
        <h1 class="text-5xl lg:text-6xl font-black text-slate-900 mt-4 uppercase tracking-tight leading-none">
          Sopar de <br />
          <span class="text-azulElectrico">Final de Temporada</span>
        </h1>
        <p class="text-lg mt-6 text-slate-600 max-w-xl mx-auto leading-relaxed">
          Arriba el moment més esperat per fer pinya i celebrar tots els èxits de l'any. Jugadors, entrenadors, famílies i afició ens unim en una nit plena de germanor, bon menjar i riures. No t'ho perdis!
        </p>
      </section>

      <hr class="border-slate-100 my-4" />

      {/* =========================================
          SECCIÓ: TARGETES D'INFORMACIÓ CLAU (MÀXIMA INTERACTIVITAT)
      ========================================= */}
      <section class="py-8 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        
        {/* targeta 1: Data i Hora */}
        <div class="bg-slate-900 text-white p-6 rounded-2xl border border-slate-800 shadow-md flex items-start gap-4">
          <div class="text-amarilloClub bg-slate-800 p-2.5 rounded-xl shrink-0">
            <Icon class="w-6 h-6" name="uil:calendar-alt" />
          </div>
          <div>
            <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider">Quan és?</h3>
            <p class="text-sm font-bold text-white mt-1">{datesSopar}</p>
            <p class="text-xs text-slate-400 mt-0.5">{hora}</p>
          </div>
        </div>

        {/* targeta 2: Lloc de celebració (Clickable -> Google Maps) */}
        <a 
          href={googleMapsUrl} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="bg-slate-900 text-white p-6 rounded-2xl border border-slate-800 shadow-md flex items-start gap-4 hover:border-slate-600 hover:bg-slate-850 transition duration-200 group"
          title="Obrir ubicació a Google Maps"
        >
          <div class="text-amarilloClub bg-slate-800 p-2.5 rounded-xl shrink-0 group-hover:scale-110 transition-transform duration-200">
            <Icon class="w-6 h-6" name="uil:map-marker" />
          </div>
          <div>
            <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider flex items-center gap-1">
              On es fa?
              <Icon class="w-3.5 h-3.5 opacity-0 group-hover:opacity-100 transition-all duration-200" name="uil:external-link-alt" />
            </h3>
            <p class="text-sm font-bold text-white mt-1 leading-tight">{lloc}</p>
          </div>
        </a>

        {/* targeta 3: Menús i preus */}
        <div class="bg-slate-900 text-white p-6 rounded-2xl border border-slate-800 shadow-md flex items-start gap-4">
          <div class="text-amarilloClub bg-slate-800 p-2.5 rounded-xl shrink-0">
            <Icon class="w-6 h-6" name="uil:restaurant" />
          </div>
          <div>
            <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider">Preu del Tiquet</h3>
            <p class="text-sm font-bold text-white mt-1">Adults: <span class="text-amarilloClub">{preuAdult}</span></p>
            <p class="text-xs text-slate-400 mt-0.5">Infantil: {preuInfantil}</p>
          </div>
        </div>

        {/* targeta 4: Data límit d'inscripció (Clickable -> Formulari) */}
        <a 
          href={linkInscripcio} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="bg-slate-900 text-white p-6 rounded-2xl border border-slate-800 shadow-md flex items-start gap-4 hover:border-slate-600 hover:bg-slate-850 transition duration-200 group text-left"
          title="Anar al formulari d'inscripció"
        >
          <div class="text-amarilloClub bg-slate-800 p-2.5 rounded-xl shrink-0 group-hover:scale-110 transition-transform duration-200">
            <Icon class="w-6 h-6" name="uil:exclamation-octagon" />
          </div>
          <div>
            <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider font-mono text-red-400 flex items-center gap-1">
              ⚠️ Atenció!
              <Icon class="w-3.5 h-3.5 opacity-0 group-hover:opacity-100 transition-all duration-200" name="uil:external-link-alt" />
            </h3>
            <p class="text-sm font-bold text-white mt-1">Límit d'inscripció: <span class="text-amarilloClub">{dataLimitInscripcio}</span></p>
          </div>
        </a>
      </section>

      {/* =========================================
          SECCIÓ: MENÚS DE GERMANOR (2 COLUMNES)
      ========================================= */}
      <section class="py-12">
        <div class="text-center max-w-2xl mx-auto mb-12">
          <span class="bg-slate-100 text-slate-800 uppercase tracking-widest text-xs font-bold px-3 py-1 rounded-full">
            Gastronomia de la festa
          </span>
          <h2 class="text-3xl lg:text-4xl font-black text-slate-900 uppercase mt-3">
            Què soparem?
          </h2>
          <p class="text-slate-500 mt-2 text-sm leading-relaxed">
            Hem preparat dues opcions molt completes per assegurar que tothom gaudeixi de la vetllada. Tria el teu menú en omplir el formulari de reserva.
          </p>
        </div>

        <div class="grid lg:grid-cols-2 gap-8 items-stretch">
          
          {/* COLUMNA 1: MENÚ ADULTS */}
          <div class="bg-slate-55 p-8 md:p-10 rounded-3xl border border-slate-200 shadow-md flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-6">
                <span class="bg-azulElectrico text-white font-black text-xs uppercase tracking-widest px-3 py-1.5 rounded-xl">
                  Menú Adults
                </span>
                <span class="text-2xl font-black text-slate-950">{preuAdult}</span>
              </div>
              <p class="text-slate-600 text-sm leading-relaxed mb-6">
                Un assortiment molt variat per començar la nit, seguit de plats consistents i tancant amb unes postres a l'altura de la celebració.
              </p>

              <ul class="space-y-4 border-t border-slate-200 pt-6">
                {menuAdult && menuAdult.map((element) => (
                  <li class="flex items-start text-sm text-slate-700">
                    <div class="bg-azulElectrico/10 text-azulElectrico p-1 rounded-lg mr-3 mt-0.5 shrink-0">
                      <Icon class="w-4 h-4" name="uil:check" />
                    </div>
                    <span>{element}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          {/* COLUMNA 2: MENÚ INFANTIL */}
          <div class="bg-slate-900 text-white p-8 md:p-10 rounded-3xl border border-slate-800 shadow-xl flex flex-col justify-between relative overflow-hidden">
            <div class="absolute -right-12 -bottom-12 text-slate-800/20">
              <Icon class="w-48 h-48" name="uil:restaurant" />
            </div>

            <div class="relative z-10">
              <div class="flex items-center justify-between mb-6">
                <span class="bg-amarilloClub text-azulOscuro font-black text-xs uppercase tracking-widest px-3 py-1.5 rounded-xl">
                  Menú Infantil
                </span>
                <span class="text-2xl font-black text-amarilloClub">{preuInfantil.split(' ')[0]}</span>
              </div>
              <p class="text-slate-300 text-sm leading-relaxed mb-6">
                Plats deliciosos pensats específicament per als jugadors de la casa. Inclou refrescos i postres divertides!
              </p>

              <ul class="space-y-4 border-t border-slate-800 pt-6">
                {menuInfantil && menuInfantil.map((element) => (
                  <li class="flex items-start text-sm text-slate-200">
                    <div class="bg-amarilloClub/10 text-amarilloClub p-1 rounded-lg mr-3 mt-0.5 shrink-0">
                      <Icon class="w-4 h-4" name="uil:check" />
                    </div>
                    <span>{element}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

        </div>
      </section>

      {/* =========================================
          🌟 SECCIÓ: FOTOGRAFIES DE TEMPORADES PASSADES
      ========================================= */}
      {fotosAnysPassats && fotosAnysPassats.length > 0 && (
        <section class="py-16">
          <div class="text-center max-w-2xl mx-auto mb-12">
            <span class="bg-azulElectrico/10 text-azulElectrico uppercase tracking-widest text-xs font-bold px-3 py-1 rounded-full">
              Història de germanor
            </span>
            <h2 class="text-3xl lg:text-4xl font-black text-slate-900 uppercase mt-3">
              Records de sopars passats
            </h2>
            <p class="text-slate-500 mt-2 text-sm leading-relaxed">
              No és només un sopar; són riures, anècdotes, premis, comiats de temporada i moments que queden gravats per sempre a l'AEB.
            </p>
          </div>

          {/* Graella de fotos de germanor (bento grid adaptatiu) */}
          <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
            {fotosAnysPassats.map((foto, index) => (
              <div class={`overflow-hidden rounded-2xl bg-slate-100 shadow-sm border border-slate-100 hover:shadow-lg transition-all duration-300 group ${
                index === 0 || index === 5 ? 'md:col-span-2 md:row-span-2' : ''
              }`}>
                <img
                  src={urlFor(foto.asset).width(800).auto('format').url()}
                  alt={foto.alt || "Sopar de final de temporada AEB La Palma"}
                  loading="lazy"
                  class="w-full h-full object-cover min-h-[200px] max-h-[400px] group-hover:scale-105 transition-transform duration-500"
                />
              </div>
            ))}
          </div>
        </section>
      )}

      {/* =========================================
          FORMULARI CTA FINAL (Inscripció)
      ========================================= */}
      <section class="my-24 max-w-3xl mx-auto text-center">
        <div class="bg-slate-900 text-white p-8 md:p-12 rounded-3xl border border-slate-800 shadow-xl relative overflow-hidden">
          <div class="absolute -left-10 -bottom-10 text-slate-800/30">
            <Icon class="w-60 h-60" name="uil:crockery" />
          </div>
          
          <div class="relative z-10">
            <span class="text-amarilloClub font-black text-xs uppercase tracking-widest">
              Reserva la teva cadira!
            </span>
            <h2 class="text-3xl lg:text-4xl font-black text-white uppercase mt-2">
              Confirma la teva <span class="text-amarilloClub">assistència</span>
            </h2>
            <p class="text-slate-300 mt-4 max-w-lg mx-auto leading-relaxed text-sm md:text-base">
              Preguem que feu la reserva de tiquets abans de la data límit indicada. Això ens ajuda a garantir el correcte càtering i organització de les taules.
            </p>

            <div class="mt-8 flex flex-col sm:flex-row gap-4 justify-center">
              <a 
                href={linkInscripcio} 
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-2 bg-azulElectrico hover:bg-azulOscuro text-white font-black px-8 py-4 rounded-2xl transition duration-200 shadow-lg"
              >
                <Icon class="w-5 h-5" name="uil:clipboard-notes" />
                Reservar el meu tiquet
              </a>
              <a 
                href="/contact" 
                class="inline-flex items-center justify-center gap-2 bg-slate-800 hover:bg-slate-700 text-white font-bold px-6 py-4 rounded-2xl transition duration-200"
              >
                Dubtes? Contacta amb el club
              </a>
            </div>
          </div>
        </div>
      </section>

    </div>
  </Container>
</Layout>