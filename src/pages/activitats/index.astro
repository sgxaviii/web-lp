---
// src/pages/activitats/index.astro
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import { Icon } from "astro-icon/components";

// 🌟 Importem el client de Sanity
import { sanityClient } from "sanity:client";

// 🌟 CONSULTA GROQ: Demanem totes les activitats ordenades pel camp 'ordre'
let activitats = [];
try {
  activitats = await sanityClient.fetch(
    `*[_type == "activitat"] | order(ordre asc, _createdAt desc) {
      titol,
      "slug": slug.current,
      ruta,
      descripcio,
      categoria,
      icona,
      etiqueta,
      etiquetaColor
    }`
  );
} catch (error) {
  console.error("Error al carregar les activitats des de Sanity:", error);
}

// 🌟 FUNCIÓ HELPER 1: Colors per a les icones
const obtenirColorIcona = (icona: string) => {
  switch (icona) {
    case "uil:basketball":
      return "text-azulElectrico bg-azulElectrico/10";
    case "uil:restaurant":
      return "text-amarilloClub bg-amarilloClub/10";
    case "uil:sun":
      return "text-orange-500 bg-orange-50";
    case "uil:users-alt":
      return "text-blue-600 bg-blue-50";
    default:
      return "text-slate-600 bg-slate-100";
  }
};

// 🌟 FUNCIÓ HELPER 2: Mapeig segur de colors per a les etiquetes
// D'aquesta manera, Tailwind compilarà SÍ O SÍ aquestes classes perquè estan escrites literalment aquí.
const obtenirEstilEtiqueta = (colorDefinit: string, textEtiqueta: string) => {
  const text = textEtiqueta ? textEtiqueta.toLowerCase() : "";
  
  // 1. Detecció automàtica de seguretat per a la urgència de places
  if (text.includes("places") || text.includes("últimes") || text.includes("limitades")) {
    return "bg-orange-100 text-orange-850 border-orange-200";
  }

  // 2. Normalitzem el valor que arriba de Sanity per si escriuen en català, anglès o envien la classe antiga
  const color = (colorDefinit || "").toLowerCase().trim();

  if (color.includes("emerald") || color.includes("verd") || color === "green") {
    return "bg-emerald-100 text-emerald-800 border-emerald-200/60";
  }
  if (color.includes("orange") || color.includes("taronja")) {
    return "bg-orange-100 text-orange-800 border-orange-200/60";
  }
  if (color.includes("amber") || color.includes("groc") || color === "yellow") {
    return "bg-amber-100 text-amber-900 border-amber-200/60";
  }
  if (color.includes("blue") || color.includes("blau")) {
    return "bg-blue-100 text-blue-800 border-blue-200/60";
  }
  
  // Color per defecte (gris neutre)
  return "bg-slate-100 text-slate-600 border-slate-200/60";
};
---

<Layout title="Activitats i Esdeveniments - AEB La Palma">
  <Container>
    <div class="mt-14 relative z-10">

      {/* =========================================
          HERO DE LA PÀGINA
      ========================================= */}
      <section class="text-center max-w-3xl mx-auto pt-8 pb-12">
        <span class="bg-amarilloClub text-azulOscuro uppercase tracking-wider text-xs font-black px-3 py-1 rounded-full shadow-sm">
          Més enllà de la pista
        </span>
        <h1 class="text-5xl lg:text-6xl font-black text-slate-900 mt-4 uppercase tracking-tight leading-none">
          Les nostres <br />
          <span class="text-azulElectrico">Activitats Extra</span>
        </h1>
        <p class="text-lg mt-6 text-slate-600 max-w-xl mx-auto leading-relaxed">
          A l'AEB La Palma no tot és la lliga regular. Organitzem esdeveniments esportius, casals de lleure i trobades socials per estrènyer llaços entre jugadors, famílies i tota la vila.
        </p>
      </section>

      <hr class="border-slate-100 my-8" />

      {/* =========================================
          DIRECTORI D'ACTIVITATS (GRAELLA DINÀMICA)
      ========================================= */}
      <section class="py-6">
        {activitats.length === 0 ? (
          <div class="text-center py-12 bg-slate-50 rounded-3xl border border-slate-200">
            <Icon class="w-12 h-12 text-slate-400 mx-auto mb-4" name="uil:info-circle" />
            <p class="text-slate-600 font-medium">No s'ha trobat cap activitat publicada al gestor de continguts.</p>
          </div>
        ) : (
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            {activitats.map((act) => {
              const destinacioRedireccio = act.ruta || (act.slug ? `/activitats/${act.slug}` : "#");
              const colorIconaClasses = obtenirColorIcona(act.icona);
              
              // 🌟 Calculem dinàmicament l'estil de l'etiqueta de forma segura per a Tailwind
              const classesEtiqueta = obtenirEstilEtiqueta(act.etiquetaColor, act.etiqueta);

              return (
                <div class="bg-white rounded-3xl border border-slate-200 p-6 md:p-8 flex flex-col justify-between shadow-sm hover:shadow-xl hover:border-slate-300 transition duration-300 group relative overflow-hidden">
                  <div>
                    {/* Capçalera de la targeta (Categoria + Etiqueta d'estat) */}
                    <div class="flex justify-between items-center mb-6">
                      <span class="text-xs font-bold text-slate-400 uppercase tracking-widest">
                        {act.categoria || "Activitat"}
                      </span>
                      {act.etiqueta && (
                        <span class={`text-xs font-bold px-3 py-1 rounded-full border ${classesEtiqueta}`}>
                          {act.etiqueta}
                        </span>
                      )}
                    </div>

                    {/* Títol i Icona de l'activitat */}
                    <div class="flex items-center gap-4 mb-4">
                      <div class={`p-3 rounded-2xl shrink-0 group-hover:scale-110 transition-transform duration-300 ${colorIconaClasses}`}>
                        <Icon class="w-7 h-7" name={act.icona || "uil:apps"} />
                      </div>
                      <h2 class="text-2xl font-black text-slate-900 uppercase tracking-tight leading-tight group-hover:text-azulElectrico transition duration-200">
                        {act.titol}
                      </h2>
                    </div>

                    {/* Descripció curta */}
                    <p class="text-slate-600 text-sm leading-relaxed mb-8">
                      {act.descripcio}
                    </p>
                  </div>

                  {/* Botó d'acció per accedir a la pàgina de destí */}
                  <div class="border-t border-slate-100 pt-6 mt-auto">
                    <a 
                      href={destinacioRedireccio}
                      class="inline-flex items-center gap-2 text-slate-900 hover:text-azulElectrico font-black text-sm uppercase tracking-wider transition duration-200"
                    >
                      Saber-ne més
                      <Icon class="w-4 h-4 transform group-hover:translate-x-1.5 transition-transform duration-200" name="uil:arrow-right" />
                    </a>
                  </div>
                </div>
              );
            })}
          </div>
        )}
      </section>

      {/* =========================================
          CTA FINAL: DUBTES O PROPOSTES
      ========================================= */}
      <section class="my-24 max-w-3xl mx-auto text-center">
        <div class="bg-slate-900 text-white p-8 md:p-12 rounded-3xl border border-slate-800 shadow-xl relative overflow-hidden">
          <div class="absolute -right-10 -bottom-10 text-slate-800/30">
            <Icon class="w-60 h-60" name="uil:basketball" />
          </div>
          
          <div class="relative z-10">
            <span class="text-amarilloClub font-black text-xs uppercase tracking-widest">
              Vols col·laborar?
            </span>
            <h2 class="text-3xl lg:text-4xl font-black text-white uppercase mt-2">
              Tens alguna <span class="text-amarilloClub">idea o proposta?</span>
            </h2>
            <p class="text-slate-300 mt-4 max-w-lg mx-auto leading-relaxed text-sm md:text-base">
              Som un club obert a tothom. Si ets un patrocinador, vols proposar una activitat o tens qualsevol dubte sobre els nostres esdeveniments, estem desitjant escoltar-te.
            </p>

            <div class="mt-8 flex justify-center">
              <a 
                href="/contact" 
                class="inline-flex items-center justify-center gap-2 bg-azulElectrico hover:bg-azulOscuro text-white font-black px-8 py-4 rounded-2xl transition duration-200 shadow-lg"
              >
                <Icon class="w-5 h-5" name="uil:envelope" />
                Posa't en contacte amb nosaltres
              </a>
            </div>
          </div>
        </div>
      </section>

    </div>
  </Container>
</Layout>