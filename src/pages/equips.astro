---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";

// Obtenim tots els equips de la col·lecció "equips"
const totsElsEquips = await getCollection("equips");

// Ordenem els equips alfabèticament pel seu nom
totsElsEquips.sort((a, b) => a.data.nom.localeCompare(b.data.nom));
---

<Layout title="Els Nostres Equips - CB Bàsquet">
  <Container>
    <div class="mt-14 relative z-10">
      
      <Sectionhead>
        <Fragment slot="title">
          <span class="text-slate-900 uppercase tracking-tight font-black">Els Nostres Equips</span>
        </Fragment>
        <Fragment slot="desc">
          <span class="text-gray-400 text-lg">
            Descobreix totes les plantilles que defensen els colors del nostre club aquesta temporada.
          </span>
        </Fragment>
      </Sectionhead>

      <main class="mt-12 mb-20">
        
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 max-w-6xl mx-auto">
          {
            totsElsEquips.map((equipo) => {
              // Utilitzem la primera imatge de la galeria de l'equip com a portada.
              // Si no n'hi ha cap, posem una imatge de bàsquet per defecte (placeholder).
              const imatgePortada = equipo.data.fotografies && equipo.data.fotografies.length > 0
                ? equipo.data.fotografies[0]
                : "https://images.unsplash.com/photo-1546519638-68e109498ffc?q=80&w=600&auto=format&fit=crop";

              return (
                <div class="bg-slate-900/60 backdrop-blur-md rounded-2xl shadow-lg border border-slate-800 overflow-hidden group hover:border-azulElectrico hover:shadow-xl transition-all duration-300 flex flex-col justify-between">
                  
                  {/* Part superior: Imatge i Dades */}
                  <a href={`/equips/${equipo.slug}`} class="block flex-grow">
                    
                    {/* Contenidor de la foto amb zoom al passar el ratolí */}
                    <div class="relative aspect-video overflow-hidden bg-slate-950 border-b border-slate-800">
                      <img
                        src={imatgePortada}
                        alt={`Fotografia oficial de l'equip ${equipo.data.nom}`}
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300 opacity-90 group-hover:opacity-100"
                        loading="lazy"
                      />
                      
                      {/* Etiqueta flotant de la Categoria */}
                      <span class="absolute top-3 left-3 bg-amarilloClub text-azulOscuro uppercase tracking-wider text-[10px] font-black px-2.5 py-1 rounded-md shadow-md">
                        {equipo.data.categoria}
                      </span>
                    </div>

                    {/* Textos de la targeta */}
                    <div class="p-5">
                      <h2 class="text-xl font-black text-white uppercase tracking-tight group-hover:text-amarilloClub transition-colors duration-200">
                        {equipo.data.nom}
                      </h2>
                      <p class="text-sm text-gray-400 mt-2">
                        Entrenador/a: <span class="text-gray-200 font-medium">{equipo.data.entrenador}</span>
                      </p>
                    </div>
                  </a>

                  {/* Botó inferior d'acció */}
                  <div class="p-5 pt-0">
                    <a
                      href={`/equips/${equipo.slug}`}
                      class="block text-center bg-azulElectrico hover:bg-azulOscuro text-white font-bold py-2.5 px-4 rounded-xl text-sm shadow-md transition duration-200 border border-azulElectrico/20"
                    >
                      Veure fitxa i partits →
                    </a>
                  </div>

                </div>
              );
            })
          }
        </div>

      </main>
    </div>
  </Container>
</Layout>