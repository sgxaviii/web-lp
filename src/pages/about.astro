---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";
import { Icon } from "astro-icon/components";

// 🌟 Importem el client de Sanity i el generador d'imatges
import { sanityClient } from "sanity:client";
import imageUrlBuilder from "@sanity/image-url";

const builder = imageUrlBuilder(sanityClient);
function urlFor(source) {
  return builder.image(source);
}

// 🌟 Demanem tots els membres del club des de Sanity
const membresSanity = await sanityClient.fetch(`*[_type == "membre"]{
  _id,
  name,
  title,
  role,
  avatar
}`);

// 🌟 Clasifiquem els membres directament segons el rol definit a la base de dades de Sanity
const direcciomembres = membresSanity.filter(
  (member) => member.role === "direccio"
);

const entrenadorsmembres = membresSanity.filter(
  (member) => member.role === "entrenador"
);
---

<Layout title="Sobre nosaltres - AEB La Palma">
  <Container>
    <Sectionhead>
      <Fragment slot="title">
        <span class="text-slate-900 uppercase tracking-tight font-black">Sobre nosaltres</span>
      </Fragment>
      <Fragment slot="desc">
        <span class="text-gray-400 text-lg">Club Bàsquet AEB La Palma (La Palma de Cervelló)</span>
      </Fragment>
    </Sectionhead>

    {/* =========================================
        SECCIÓ TEXT COMPROMÍS I VALORS
        👉 S'afegeix id="valors" i marge de desplaçament
    ========================================= */}
    <div 
      id="valors" 
      class="flex flex-col gap-5 mx-auto max-w-4xl mt-16 bg-slate-50/50 p-8 rounded-3xl border border-slate-100 shadow-sm scroll-mt-24"
    >
      <h2 class="font-black text-3xl text-slate-900 uppercase tracking-tight">
        Formació en <span class="text-azulElectrico">valors</span> des de l'escola
      </h2>
      <p class="text-lg leading-relaxed text-slate-600">
        Benvinguts al nostre club, un espai on el bàsquet és molt més que un joc: 
        és la nostra eina per formar persones. Des de la nostra fundació, 
        ens dediquem a cultivar el talent esportiu sense oblidar que el nostre principal
        objectiu és transmetre els valors fonamentals de l'esport. Creiem fermament que cada entrenament
        i cada partit són oportunitats úniques per aprendre el significat del treball en equip,
        el respecte mutu, la superació personal i el compromís.
      </p>
      <p class="text-lg leading-relaxed text-slate-600">
        Aquí, cada jugador i jugadora, des de les categories d'iniciació fins als equips sènior,
        troba un entorn segur i motivador on créixer de manera integral.
        No mesurem el nostre èxit només en títols o marcadors, sinó en la unió de la nostra afició,
        l'esforç compartit a la pista i l'amistat que neix fora d'ella.
      </p>
      <p class="text-lg leading-relaxed text-slate-600 font-semibold italic text-slate-700 border-l-4 border-amarilloClub pl-4">
        Som una gran família unida per la mateixa passió, on l'esportivitat, 
        la disciplina positiva i la inclusió són els nostres millors sistemes de joc. 
        Truquem a la teva porta per convidar-te a créixer, competir i gaudir amb nosaltres. 
        ¡Som club, som valors, som bàsquet!
      </p>
    </div>

    {/* =========================================
        SECCIÓ 1: DIRECCIÓ / JUNTA DIRECTIVA
        👉 S'afegeix id="direccio" i marge de desplaçament
    ========================================= */}
    <div id="direccio" class="mt-24 scroll-mt-24">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="font-black text-3xl text-slate-900 uppercase tracking-tight">
          La <span class="text-azulElectrico">Direcció</span> i Junta
        </h2>
        <p class="text-slate-500 mt-3 text-sm md:text-base">
          Les persones encarregades de la gestió institucional, la planificació estratègica i de vetllar perquè els valors de l'AEB La Palma es mantinguin ferms dia a dia.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-10 mx-auto max-w-4xl justify-center">
        {
          direcciomembres.map((member) => {
            const imatgeUrl = member.avatar 
              ? urlFor(member.avatar).width(400).height(400).fit("crop").url()
              : "https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?q=80&w=400&auto=format&fit=crop";

            return (
              <div class="group flex flex-col items-center">
                <div class="w-full max-w-[260px] aspect-square overflow-hidden rounded-2xl border-2 border-slate-200 group-hover:border-azulElectrico group-hover:shadow-xl transition-all duration-300 bg-white">
                  <img
                    src={imatgeUrl}
                    alt={member.name}
                    class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-300"
                    loading="lazy"
                  />
                </div>

                <div class="mt-4 text-center">
                  <h3 class="text-lg font-black text-slate-900 uppercase tracking-tight group-hover:text-azulElectrico transition-colors duration-200">
                    {member.name}
                  </h3>
                  <p class="text-sm text-slate-500 font-bold uppercase tracking-wider text-[11px] mt-1 text-azulOscuro">
                    {member.title}
                  </p>
                </div>
              </div>
            );
          })
        }
      </div>
    </div>

    {/* =========================================
        SECCIÓ 2: ENTRENADORS I COS TÈCNIC
        👉 S'afegeix id="entrenadors" i marge de desplaçament
    ========================================= */}
    <div id="entrenadors" class="mt-24 mb-32 scroll-mt-24">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="font-black text-3xl text-slate-900 uppercase tracking-tight">
          Els nostres <span class="text-azulElectrico">Entrenadors</span>
        </h2>
        <p class="text-slate-500 mt-3 text-sm md:text-base">
          El cor esportiu del club. Formadors i formadores que treballen directament a pista amb els nens, nenes i joves, transmetent tècnica, passió i disciplina positiva.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-10 mx-auto max-w-4xl justify-center">
        {
          entrenadorsmembres.map((member) => {
            const imatgeUrl = member.avatar 
              ? urlFor(member.avatar).width(400).height(400).fit("crop").url()
              : "https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?q=80&w=400&auto=format&fit=crop";

            return (
              <div class="group flex flex-col items-center">
                <div class="w-full max-w-[260px] aspect-square overflow-hidden rounded-2xl border-2 border-slate-200 group-hover:border-azulElectrico group-hover:shadow-xl transition-all duration-300 bg-white">
                  <img
                    src={imatgeUrl}
                    alt={member.name}
                    class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-300"
                    loading="lazy"
                  />
                </div>

                <div class="mt-4 text-center">
                  <h3 class="text-lg font-black text-slate-900 uppercase tracking-tight group-hover:text-azulElectrico transition-colors duration-200">
                    {member.name}
                  </h3>
                  <p class="text-sm text-slate-500 font-bold uppercase tracking-wider text-[11px] mt-1 text-azulOscuro">
                    {member.title}
                  </p>
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
  </Container>
</Layout>