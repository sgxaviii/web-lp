---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import { sanityClient } from "sanity:client";
import imageUrlBuilder from "@sanity/image-url";

const builder = imageUrlBuilder(sanityClient);
function urlFor(source) {
  return builder.image(source);
}

// Obtenim tots els patrocinadors de Sanity ordenats alfabèticament
const patrocinadors = await sanityClient.fetch(`*[_type == "patrocinador"] | order(nom asc)`);
---

<Layout title="Patrocinadors Oficials - AEB La Palma">
  <Container>
    <div class="mx-auto max-w-6xl mt-16 relative z-10 mb-28">
      
      {/* 🌟 Capçalera de la pàgina estilitzada amb fons fosc i vora de contrast blau */}
      <div class="bg-slate-900/50 border border-slate-800 p-10 rounded-[2.5rem] mb-12 text-center shadow-xl shadow-slate-950/10 relative overflow-hidden">
        {/* Detall decoratiu de fons (Glow Blau) */}
        <div class="absolute -top-12 -left-12 w-48 h-48 bg-azulElectrico/10 rounded-full blur-[80px] pointer-events-none z-0"></div>
        
        <h1 class="relative z-10 text-4xl lg:text-5xl font-black text-white uppercase tracking-tighter leading-none select-none text-transparent bg-clip-text bg-gradient-to-b from-white to-slate-200">
          Patrocinadors <span class="text-azulElectrico">Oficials</span><span class="text-amarilloClub">.</span>
        </h1>
        <p class="relative z-10 text-slate-400 mt-5 text-lg max-w-3xl mx-auto leading-relaxed">
          Gràcies al compromís i suport d'aquestes empreses i entitats, fem possible que l'esport, la competició i els nostres valors segueixin creixent dia a dia a La Palma de Cervelló.
        </p>
      </div>

      {/* Grid de patrocinadors */}
      {patrocinadors.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
          {patrocinadors.map((patro) => {
            // Si té link, la targeta sencera esdevé una etiqueta <a>, si no, un <div>
            const CardTag = patro.link ? "a" : "div";
            
            return (
              <CardTag 
                href={patro.link} 
                target={patro.link ? "_blank" : undefined} 
                rel={patro.link ? "noopener noreferrer" : undefined}
                /* 🌟 Targeta Fosc d'Alt Contrast: Fons fosc, vora fina, hover de focus blau */
                class="bg-slate-950/40 p-6 rounded-3xl border border-slate-800/80 shadow-lg shadow-slate-950/5 flex flex-col justify-between transition-all duration-300 hover:border-azulElectrico hover:bg-slate-950/80 hover:scale-[1.03] group block cursor-pointer text-left h-full"
              >
                
                <div>
                  {/* 🌟 Contenidor del Logo: Fons encara més fosc (shadow-inner) per fer ressaltar logos blancs */}
                  <div class="bg-slate-950 p-6 rounded-2xl border border-slate-800/60 h-36 flex items-center justify-center mb-6 shadow-inner relative overflow-hidden">
                    <img 
                      src={urlFor(patro.logo).width(400).url()} 
                      alt={`Logo de ${patro.nom}`} 
                      /* 🌟 Efecte d'Imatge: Opacitat inicial baixa i grayscale. Al hover, color total i escala suau */
                      class="max-h-full max-w-full object-contain filter drop-shadow-sm opacity-50 grayscale group-hover:opacity-100 group-hover:grayscale-0 group-hover:scale-105 transition duration-300"
                      loading="lazy"
                    />
                  </div>

                  {/* Títol: Canvi a Groc Club en hover */}
                  <h2 class="text-xl sm:text-2xl font-black text-white mb-2 leading-tight group-hover:text-amarilloClub transition-colors">
                    {patro.nom}
                  </h2>

                  {/* Descripció opcional: Text slate-400 clàssic */}
                  {patro.descripcio && (
                    <p class="text-sm text-slate-400 line-clamp-3 mb-5 leading-relaxed font-medium">
                      {patro.descripcio}
                    </p>
                  )}
                </div>

                {/* 🌟 Botó d'enllaç web visual (Estil Botó Principal optimitzat) */}
                {patro.link && (
                  <span class="mt-auto inline-flex items-center justify-center gap-2 bg-[#1D4ED8] group-hover:bg-[#FBBF24] group-hover:text-slate-950 text-white text-xs font-black px-5 py-3.5 rounded-xl transition-all duration-300 shadow-md w-full uppercase tracking-wider">
                    Visitar Web Oficial ↗
                  </span>
                )}

              </CardTag>
            );
          })}
        </div>
      ) : (
        /* 🌟 Estat Buit (Empty State): Fons fosc, vora dashed i text integrat */
        <div class="text-center bg-slate-950/30 p-16 rounded-[2rem] border-2 border-slate-800 border-dashed max-w-2xl mx-auto shadow-xl shadow-slate-950/10">
          <p class="text-white text-xl font-bold tracking-tight">Actualment estem actualitzant la llista de patrocinadors Oficials.</p>
          <p class="text-slate-400 text-base mt-3 leading-relaxed">Vols patrocinar a l'AEB La Palma i aparèixer en aquesta llista? <a href="/contact" class="text-amarilloClub hover:text-white font-semibold transition-colors">Posa't en contacte</a> amb la junta directiva del club!</p>
        </div>
      )}

    </div>
  </Container>
</Layout>