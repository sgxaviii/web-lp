---
// src/layouts/Layout.astro
import { SEO } from "astro-seo";
import Footer from "@/components/footer.astro";
import Navbar from "@/components/navbar/navbar.astro";

// 📊 1. Importem Vercel Analytics
import Analytics from "@vercel/analytics/astro";

// 🏀 2. Importem el component d'optimització d'imatges d'Astro
import { Image } from "astro:assets";

// 🏀 3. Importem la teva imatge local (.png) des de src/assets/
import fonsAeb from "../assets/fons-aeb.png";

// 🚧 Interruptors de bloqueig temporal (src/config/bloqueig.ts)
import { bloqueig, missatgeImatges } from "../config/bloqueig";

import "@fontsource-variable/inter/index.css";
import "@fontsource-variable/bricolage-grotesque";
import "../styles/global.css";

export interface Props {
  title: string;
}

const { title } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
const resolvedImageWithDomain = new URL("/opengraph.jpg", Astro.site || "http://localhost:4321").toString();

const makeTitle = title
  ? title + " | AEB La Palma"
  : "AEB La Palma - Club de Bàsquet a La Palma de Cervelló";
---

<!doctype html>
<html lang="ca" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <SEO
      title={makeTitle}
      description="Web oficial de l'AEB La Palma. Club de bàsquet i formació en valors a La Palma de Cervelló. Equips, entrenaments, escola i competicions."
      canonical={canonicalURL}
      twitter={{
        creator: "@aeblapalma",
        site: "@aeblapalma",
        card: "summary_large_image",
      }}
      openGraph={{
        basic: {
          url: canonicalURL,
          type: "website",
          title: `AEB La Palma - Som club, som valors, som bàsquet`,
          image: resolvedImageWithDomain,
        },
        image: {
          alt: "AEB La Palma - Club de Bàsquet de La Palma de Cervelló",
        },
      }}
    />

    <!-- 📊 Component de Vercel Analytics -->
    <Analytics />
  </head>
  
  <body class="relative min-h-screen overflow-x-hidden bg-slate-950 text-slate-100">
    
    <div class="fixed inset-0 z-0 overflow-hidden pointer-events-none [backface-visibility:hidden] [transform:translate3d(0,0,0)] bg-slate-950">
      <img
        src="/fons-aeb.png" 
        alt="Fons de pantalla oficial AEB La Palma"
        class="w-full h-full object-cover object-center [content-visibility:visible!important]" 
        loading="eager"
        decoding="async"
      />
      <div class="absolute inset-0 bg-slate-950/90"></div>
    </div>

    <div class="relative z-10 flex flex-col min-h-screen justify-between">
      <Navbar />
      <main class="flex-grow">
        <slot />
      </main>
      <Footer />
    </div>

    <style is:global>
      /* Improve Page speed (excloent la imatge de fons per evitar parpelleig) */
      img:not([alt*="Fons"]) {
        content-visibility: auto;
      }
    </style>

    {bloqueig.imatges && (
      <>
        {/* 🚧 Imatges de contingut no disponibles: es mantenen el logo i el fons de marca */}
        <style is:global>
          img:not([src^="/logo"]):not([src^="/fons-aeb"]):not([src^="/favicon"]):not(#modalImage):not(#modal-img) {
            visibility: hidden;
          }
          .imatge-no-disponible {
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            min-height: 6rem;
            padding: 0.5rem;
            box-sizing: border-box;
            background: rgb(30 41 59 / 0.6);
            border: 1px dashed rgb(100 116 139);
            color: rgb(148 163 184);
            font-size: 0.75rem;
            font-weight: 600;
            line-height: 1.2;
          }
        </style>
        <script is:inline define:vars={{ missatgeImatges }}>
          (function () {
            var marca = /^\/(logo|fons-aeb|favicon)/;
            function esMarca(img) {
              if (img.id === "modalImage" || img.id === "modal-img") return true;
              if (img.closest(".imatge-no-disponible")) return true;
              var src = img.getAttribute("src") || "";
              return marca.test(src);
            }
            function substituir(img) {
              if (esMarca(img) || img.dataset.bloquejada) return;
              img.dataset.bloquejada = "1";
              var caixa = document.createElement("div");
              caixa.className = (img.getAttribute("class") || "") + " imatge-no-disponible";
              caixa.setAttribute("role", "img");
              caixa.setAttribute("aria-label", missatgeImatges);
              caixa.textContent = missatgeImatges;
              img.style.display = "none";
              img.removeAttribute("srcset");
              img.parentNode.insertBefore(caixa, img);
            }
            function tot(arrel) {
              (arrel.querySelectorAll ? arrel.querySelectorAll("img") : []).forEach(substituir);
            }
            tot(document);
            document.addEventListener("DOMContentLoaded", function () { tot(document); });
            new MutationObserver(function (mutacions) {
              mutacions.forEach(function (m) {
                m.addedNodes.forEach(function (n) {
                  if (n.nodeType !== 1) return;
                  if (n.tagName === "IMG") substituir(n);
                  else tot(n);
                });
              });
            }).observe(document.documentElement, { childList: true, subtree: true });
          })();
        </script>
      </>
    )}
  </body>
</html>

<style is:global>
  :root {
    --color-amarilloClub: #FBBF24;
    --color-amarilloBrillante: #F59E0B;
    --color-azulElectrico: #1D4ED8;
    --color-azulOscuro: #1E3A8A;
    --color-red-650: #E02424;
    --color-red-750: #9B1C1C;
  }
  .bg-amarilloClub { background-color: var(--color-amarilloClub); }
  .text-amarilloClub { color: var(--color-amarilloClub); }
  .border-amarilloClub { border-color: var(--color-amarilloClub); }
  .hover\:text-amarilloBrillante:hover { color: var(--color-amarilloBrillante); }
  .bg-azulElectrico { background-color: var(--color-azulElectrico); }
  .text-azulElectrico { color: var(--color-azulElectrico); }
  .border-azulElectrico { border-color: var(--color-azulElectrico); }
  .hover\:border-azulElectrico:hover { border-color: var(--color-azulElectrico); }
  .bg-azulOscuro { background-color: var(--color-azulOscuro); }
  .text-azulOscuro { color: var(--color-azulOscuro); }
  .hover\:bg-azulOscuro:hover { background-color: var(--color-azulOscuro); }
  .bg-red-650 { background-color: var(--color-red-650); }
  .hover\:bg-red-750:hover { background-color: var(--color-red-750); }
</style>